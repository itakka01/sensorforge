// Beta135/136 regression test: time-source flapping (coordinator vs. broadcaster beacons)
//
// Uses the REAL decision functions from cluster_time_source_policy.h (also called by
// cluster_espnow_radio.cpp) and the REAL wire codec / replay window from
// cluster_espnow_packets.cpp. The RX dispatch and lease timing around them are a
// simplified model of cluster_espnow_radio.cpp (not compiled from it).
//
// Build & run (host):
//   g++ -std=c++17 -Wall -Wextra -I. -x c++ test_time_source_flapping.cpp.test
//       -x c++ cluster_espnow_packets.cpp -o /tmp/test_time_source_flapping
//   /tmp/test_time_source_flapping

#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include "cluster_time_source_policy.h"
#include "cluster_espnow_packets.h"

using namespace ClusterTimeSourcePolicy;

static int g_failures = 0;
#define CHECK(cond, msg) do { if (cond) printf("  PASS %s\n", msg); \
    else { printf("  FAIL %s (line %d)\n", msg, __LINE__); ++g_failures; } } while (0)

// ---------------------------------------------------------------- simulation model
constexpr uint64_t kCoordTag = 0x6e5bd8e7a95c0236ULL, kBcastTag = 0x1111222233334444ULL;
constexpr uint32_t kBroadcastEveryMs = 10000;   // cluster_espnow_radio.cpp kBroadcastEveryMs
constexpr uint32_t kProductionEveryMs = 200;    // observed ~5 production beacons/s on devxiao3
constexpr uint32_t kGrantEveryMs = 2000, kLeaseMs = 3000, kSafetyMs = 1000;
constexpr uint32_t kSuppressionDelayMs = 10000;

struct Sim {
    bool coordinatorSeesBeacons = true;  // false = beta134 dispatch (beacons rejected)
    uint64_t coordBoot = 0xC0, bcastBoot = 0xB0; uint32_t epoch = 4274446014U;
    // coordinator
    bool leaseActive = false; uint32_t leaseExpires = 0, suppressionStart = 0, lastLeasedBeacon = 0;
    uint64_t leaseTag = 0, leaseBoot = 0; uint32_t nextGrant = 0, nextCoordBeacon = 1000;
    uint32_t coordBeaconsSent = 0;
    bool earlyResume = true;             // false = beta135 (wait for next 10 s slot)
    bool lastSlotSuppressed = false; uint32_t earlyResumes = 0;
    // broadcaster
    bool bcastAlive = true, bcastTimeValid = true; uint32_t bcastLeaseExpires = 0, nextProd = 0;
    // node
    uint64_t activeTag = 0, activeBoot = 0; uint32_t activeEpoch = 0, sourceChanges = 0;
    uint32_t lastBeaconRx = 0, maxBeaconGap = 0;

    void nodeRx(uint64_t tag, uint64_t boot, uint32_t now) {
        if (isSourceChange(activeTag, activeBoot, activeEpoch, tag, boot, epoch)) ++sourceChanges;
        activeTag = tag; activeBoot = boot; activeEpoch = epoch;
        if (lastBeaconRx && now - lastBeaconRx > maxBeaconGap) maxBeaconGap = now - lastBeaconRx;
        lastBeaconRx = now;
    }
    uint64_t probeTarget() const { return activeTag ? activeTag : kCoordTag; }  // firmware fallback rule

    void tick(uint32_t now) {
        // Coordinator grants while the broadcaster's diagnostic beacons are heard.
        if (leaseActive && now >= leaseExpires) { leaseActive = false; suppressionStart = 0; }
        if (bcastAlive && now >= nextGrant) {
            nextGrant = now + kGrantEveryMs;
            if (!leaseActive) {
                leaseActive = true; leaseTag = kBcastTag; leaseBoot = bcastBoot;
                suppressionStart = now + kSuppressionDelayMs;
                leaseExpires = now + kLeaseMs + kSafetyMs;
            } else if (leaseExpires - now <= 2000U) leaseExpires = now + kLeaseMs + kSafetyMs;
            bcastLeaseExpires = now + kLeaseMs;  // broadcaster accepts grant
        }
        // Broadcaster production beacons (lease + valid time base required).
        if (bcastAlive && bcastTimeValid && now < bcastLeaseExpires && now >= nextProd) {
            nextProd = now + kProductionEveryMs;
            nodeRx(kBcastTag, bcastBoot, now);
            if (coordinatorSeesBeacons &&
                isLeasedBroadcasterBeacon(leaseActive, leaseTag, leaseBoot, kBcastTag, bcastBoot))
                lastLeasedBeacon = now;
        }
        // Coordinator beacon slot (beta136: early resume after confirmation loss).
        const bool suppressNow = coordinatorShouldSuppressBeacon(leaseActive, suppressionStart, lastLeasedBeacon, now);
        if (earlyResume && coordinatorShouldResumeEarly(lastSlotSuppressed, suppressNow)) {
            lastSlotSuppressed = false; ++earlyResumes; nextCoordBeacon = now;
        }
        if (now >= nextCoordBeacon) {
            nextCoordBeacon = now + kBroadcastEveryMs;
            if (suppressNow) lastSlotSuppressed = true;
            else { lastSlotSuppressed = false; ++coordBeaconsSent; nodeRx(kCoordTag, coordBoot, now); }
        }
    }
    void run(uint32_t from, uint32_t to) { for (uint32_t t = from; t < to; t += 10) tick(t); }
};

// ---------------------------------------------------------------- tests
static void test1_bothSendersValid() {
    printf("T1 coordinator and broadcaster both send valid beacons\n");
    Sim before; before.coordinatorSeesBeacons = false; before.run(0, 300000);
    printf("  beta134 model: source_changes=%u in 300 s\n", before.sourceChanges);
    CHECK(before.sourceChanges >= 50, "beta134 dispatch reproduces ~2 changes per 10 s");
    Sim after; after.run(0, 300000);
    printf("  beta135 model: source_changes=%u coordinator beacons=%u\n", after.sourceChanges, after.coordBeaconsSent);
    CHECK(after.sourceChanges <= 2, "fixed dispatch: only bootstrap grace may switch");
}

static void test2_leaseActivationDeactivation() {
    printf("T2 lease activation / deactivation\n");
    CHECK(!coordinatorShouldSuppressBeacon(false, 5000, 4900, 6000), "no lease -> no suppression");
    CHECK(!coordinatorShouldSuppressBeacon(true, 15000, 9900, 10000), "grace not elapsed -> no suppression");
    CHECK(coordinatorShouldSuppressBeacon(true, 15000, 15900, 16000), "lease + grace + recent beacon -> suppress");
    CHECK(!coordinatorShouldSuppressBeacon(true, 15000, 0, 16000), "never heard broadcaster -> no suppression");
    CHECK(!coordinatorShouldSuppressBeacon(true, 15000, 13000, 16000), "beacon older than 2 s -> no suppression");
}

static void test3_bootEpochChange() {
    printf("T3 coordinator boot / epoch change\n");
    CHECK(isSourceChange(kCoordTag, 0xC0, 1, kCoordTag, 0xC1, 1), "new coordinator boot is a source change");
    CHECK(isSourceChange(kCoordTag, 0xC0, 1, kCoordTag, 0xC0, 2), "new epoch is a source change");
    CHECK(!isSourceChange(kCoordTag, 0xC0, 1, kCoordTag, 0xC0, 1), "same identity is not a change");
    CHECK(!isSourceChange(0, 0, 0, kCoordTag, 0xC0, 1), "first source is not counted as change");
    CHECK(!isLeasedBroadcasterBeacon(true, kBcastTag, 0xB0, kBcastTag, 0xB1), "rebooted broadcaster not confirmed by old lease");
}

static void test4_broadcasterFailAndReturn() {
    printf("T4 broadcaster fails and returns\n");
    Sim s; s.run(0, 150000);
    const uint32_t base = s.sourceChanges;
    s.bcastAlive = false; s.run(150000, 200000);
    CHECK(s.activeTag == kCoordTag, "node falls back to coordinator beacons");
    CHECK(s.probeTarget() == kCoordTag, "probes follow the coordinator after failover");
    CHECK(s.sourceChanges - base == 1, "exactly one change on failover");
    const uint32_t gapDuringOutage = s.maxBeaconGap;
    printf("  max beacon gap during outage: %u ms\n", gapDuringOutage);
    CHECK(gapDuringOutage <= kBroadcastEveryMs + 2 * kGrantEveryMs, "coordinator resumes within one beacon period");
    s.bcastAlive = true; s.bcastBoot = 0xB1; s.run(200000, 300000);
    CHECK(s.activeTag == kBcastTag && s.probeTarget() == kBcastTag, "node returns to broadcaster");
    printf("  changes after return: %u\n", s.sourceChanges - base - 1);
    CHECK(s.sourceChanges - base - 1 <= 3, "return settles after grace (bounded changes)");
}

static void test5_precisionInvalidThenValid() {
    printf("T5 broadcaster precision invalid, later valid\n");
    Sim s; s.run(0, 100000);
    const uint32_t base = s.sourceChanges;
    s.bcastTimeValid = false; s.run(100000, 140000);
    CHECK(s.activeTag == kCoordTag, "coordinator takes over while broadcaster has no time base");
    s.bcastTimeValid = true; s.run(140000, 240000);
    CHECK(s.activeTag == kBcastTag, "broadcaster resumes when time base valid again");
    CHECK(s.sourceChanges - base <= 2, "one change out, one change back");
}

static bool fakeSign(const uint8_t* d, size_t n, uint8_t mac[32], void*) {
    uint8_t acc = 0x5A; for (size_t i = 0; i < n; ++i) acc = static_cast<uint8_t>(acc * 31 + d[i]);
    for (int i = 0; i < 32; ++i) mac[i] = static_cast<uint8_t>(acc + i);
    return true;
}
static bool fakeVerify(const uint8_t* d, size_t n, const uint8_t mac[32], void* u) {
    uint8_t expect[32]; fakeSign(d, n, expect, u); return memcmp(expect, mac, 32) == 0;
}

static void test6_staleWrongRepeated() {
    printf("T6 stale, wrong and repeated frames rejected\n");
    using namespace EspNowTimePackets;
    Frame f; f.type = Type::Beacon; f.epoch = 7; f.sequence = 10; f.coordinatorTag = kBcastTag; f.senderBoot = 0xB0;
    f.timeUs = 1700000000000000LL;
    uint8_t wire[kPacketSize]; Frame out;
    CHECK(encode(f, wire, fakeSign, nullptr) && decode(wire, sizeof(wire), out, fakeVerify, nullptr), "valid frame decodes");
    wire[20] ^= 0x01;
    CHECK(!decode(wire, sizeof(wire), out, fakeVerify, nullptr), "tampered frame fails MAC");
    ReplayWindow w;
    CHECK(acceptSequence(w, f), "first sequence accepted");
    CHECK(!acceptSequence(w, f), "repeated sequence rejected");
    Frame older = f; older.sequence = 9;
    CHECK(!acceptSequence(w, older), "older sequence rejected");
    Frame otherEpoch = f; otherEpoch.epoch = 6; otherEpoch.sequence = 11;
    CHECK(!acceptSequence(w, otherEpoch), "foreign epoch rejected by window");
    CHECK(!isLeasedBroadcasterBeacon(true, kBcastTag, 0xB0, 0x9999, 0xB0), "unleased sender never confirms broadcaster");
    CHECK(!isLeasedBroadcasterBeacon(false, kBcastTag, 0xB0, kBcastTag, 0xB0), "no lease -> no confirmation");
}

static void test7_steadyStateNoChanges() {
    printf("T7 no unjustified source changes in steady state\n");
    Sim s; s.run(0, 30000);
    const uint32_t base = s.sourceChanges;
    s.run(30000, 330000);
    CHECK(s.sourceChanges == base, "zero source changes over 300 s steady state");
    CHECK(s.activeTag == kBcastTag, "leased broadcaster stays active source");
}

static void test8_probesAfterSwitch() {
    printf("T8 probes target the valid source after legitimate switches\n");
    Sim s; s.run(0, 60000);
    CHECK(s.probeTarget() == kBcastTag, "steady state probes broadcaster");
    s.coordBoot = 0xC1; s.bcastAlive = false; s.run(60000, 90000);
    CHECK(s.probeTarget() == kCoordTag && s.activeBoot == 0xC1, "after failover probes the (rebooted) coordinator");
}

static void test9_earlyResume() {
    printf("T9 coordinator resumes early after broadcaster loss (beta136)\n");
    // Gap = last broadcaster beacon -> first coordinator beacon (nodes without a source).
    auto outageGap = [](Sim &s, uint32_t from) {
        s.bcastAlive = false; const uint32_t lastBcast = s.lastBeaconRx; uint32_t t = from;
        while (s.activeTag != kCoordTag && t < from + 30000) { s.tick(t); t += 10; }
        return s.lastBeaconRx - lastBcast;
    };
    Sim old; old.earlyResume = false; old.run(0, 120130);
    const uint32_t oldGap = outageGap(old, 120130);
    Sim neu; neu.run(0, 120130);
    const uint32_t steadyEarly = neu.earlyResumes;
    const uint32_t newGap = outageGap(neu, 120130);
    neu.run(neu.lastBeaconRx + 10, 160000);
    printf("  gap without beacon source: beta135 %u ms, beta136 %u ms\n", oldGap, newGap);
    CHECK(steadyEarly == 0, "no early resume in steady state");
    CHECK(neu.earlyResumes == 1, "exactly one early beacon per loss");
    CHECK(newGap <= kBroadcasterConfirmWindowMs + 100, "gap <= confirm window (+1 tick)");
    CHECK(newGap < oldGap, "shorter than waiting for the next 10 s slot");
    CHECK(neu.activeTag == kCoordTag, "node on coordinator during outage");
    neu.bcastAlive = true; neu.bcastBoot = 0xB2; neu.run(160000, 260000);
    CHECK(neu.activeTag == kBcastTag, "broadcaster resumes after return");
    Sim blip; blip.run(0, 60000);
    const uint32_t base = blip.sourceChanges;
    blip.bcastAlive = false; blip.run(60000, 61500); blip.bcastAlive = true; blip.run(61500, 120000);
    CHECK(blip.earlyResumes == 0 && blip.sourceChanges == base, "1.5 s beacon gap: no resume, no switch");
}

int main() {
    printf("=== Time source flapping regression (beta135/136) ===\n");
    test1_bothSendersValid(); test2_leaseActivationDeactivation(); test3_bootEpochChange();
    test4_broadcasterFailAndReturn(); test5_precisionInvalidThenValid(); test6_staleWrongRepeated();
    test7_steadyStateNoChanges(); test8_probesAfterSwitch(); test9_earlyResume();
    printf("=== %s (%d failures) ===\n", g_failures ? "FAILED" : "ALL PASSED", g_failures);
    return g_failures ? 1 : 0;
}
