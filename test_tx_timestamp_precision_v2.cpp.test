#include <stdio.h>
#include <stdint.h>
#include <assert.h>
#include <math.h>

// Critical Test: V2 MUST use CURRENT Probe delay, NOT previous Probe delay
// Uses MONOTONICALLY INCREASING delays to create systematic bias if wrong

struct Sample {
    int64_t t1_early;
    uint32_t actual_delay;
    int64_t t1_correct;   // With CURRENT delay
    int64_t t1_wrong;     // With PREVIOUS delay
    int64_t offset_correct;
    int64_t offset_wrong;
};

int main() {
    printf("=== V2 TX Precision Test: Monotonically Increasing Delays ===\n\n");

    // Monotonically increasing delays: 600, 700, 800, 900 µs
    // WRONG implementation will be 100 µs behind on each Probe
    uint32_t probe_delays[4] = {600, 700, 800, 900};

    int64_t true_offset = -1000;  // Node is 1000 µs ahead of Coordinator
    uint32_t reply_delay = 730;   // Coordinator Reply delay
    int64_t rtt_half = 1000;      // Half of round-trip time (propagation + processing)

    printf("Test Setup:\n");
    printf("- Probe delays: 600, 700, 800, 900 µs (monotonically increasing)\n");
    printf("- True clock offset: %lld µs (Node ahead)\n", (long long)true_offset);
    printf("- Reply delay: %u µs\n", reply_delay);
    printf("- Expected: CORRECT uses actual delay, WRONG uses previous delay\n");
    printf("- Expected: WRONG will have +100 µs systematic bias on each Probe\n\n");

    Sample samples[4];

    uint32_t previous_delay = 0;  // For WRONG implementation
    int64_t sum_offset_correct = 0;
    int64_t sum_offset_wrong = 0;

    printf("Individual Probe Analysis:\n");
    printf("Probe | Actual | Previous | t1_error(WRONG) | Offset(CORRECT) | Offset(WRONG) | Δ\n");
    printf("------|--------|----------|-----------------|-----------------|---------------|---------\n");

    for(int i = 0; i < 4; i++) {
        int64_t t1_early = 1000000 + i * 100000;
        uint32_t actual_delay = probe_delays[i];

        // CORRECT: Use CURRENT delay
        int64_t t1_correct = t1_early + actual_delay;

        // WRONG: Use PREVIOUS delay
        int64_t t1_wrong = t1_early + previous_delay;

        // Simulate offset calculation (simplified: offset = t2 - t1 - rtt_half/2)
        // In reality: offset = ((t2-t1) + (t3-t4)) / 2
        // With t1 corrected, offset should be close to true_offset

        int64_t offset_correct = true_offset;  // Correct t1 → correct offset
        int64_t offset_wrong = true_offset + (previous_delay - actual_delay);  // Wrong t1 → biased offset

        int64_t t1_error_wrong = static_cast<int64_t>(previous_delay) - static_cast<int64_t>(actual_delay);
        int64_t offset_delta = offset_wrong - offset_correct;

        samples[i] = {t1_early, actual_delay, t1_correct, t1_wrong, offset_correct, offset_wrong};

        sum_offset_correct += offset_correct;
        sum_offset_wrong += offset_wrong;

        printf("%5d | %6u | %8u | %15lld | %15lld | %13lld | %lld\n",
               i, actual_delay, previous_delay, (long long)t1_error_wrong,
               (long long)offset_correct, (long long)offset_wrong, (long long)offset_delta);

        previous_delay = actual_delay;  // For next iteration (WRONG logic)
    }

    int64_t mean_offset_correct = sum_offset_correct / 4;
    int64_t mean_offset_wrong = sum_offset_wrong / 4;

    printf("\n=== Results ===\n");
    printf("CORRECT implementation:\n");
    printf("  Mean offset: %lld µs\n", (long long)mean_offset_correct);
    printf("  Error from true offset: %lld µs\n", (long long)(mean_offset_correct - true_offset));

    printf("\nWRONG implementation (uses previous delay):\n");
    printf("  Mean offset: %lld µs\n", (long long)mean_offset_wrong);
    printf("  Error from true offset: %lld µs\n", (long long)(mean_offset_wrong - true_offset));

    // Calculate spread for each
    double sum_sq_correct = 0;
    double sum_sq_wrong = 0;
    for(int i = 0; i < 4; i++) {
        double dev_correct = samples[i].offset_correct - mean_offset_correct;
        double dev_wrong = samples[i].offset_wrong - mean_offset_wrong;
        sum_sq_correct += dev_correct * dev_correct;
        sum_sq_wrong += dev_wrong * dev_wrong;
    }
    double stddev_correct = sqrt(sum_sq_correct / 4);
    double stddev_wrong = sqrt(sum_sq_wrong / 4);

    printf("\nSpread Analysis:\n");
    printf("  CORRECT stddev: %.2f µs\n", stddev_correct);
    printf("  WRONG stddev: %.2f µs\n", stddev_wrong);

    printf("\n=== Verification ===\n");

    // Test 1: CORRECT should have zero error
    bool test1 = (mean_offset_correct == true_offset);
    printf("Test 1 - CORRECT has zero mean error: %s\n", test1 ? "PASS ✓" : "FAIL ✗");

    // Test 2: WRONG should have systematic bias
    bool test2 = (mean_offset_wrong != true_offset);
    printf("Test 2 - WRONG has systematic bias: %s\n", test2 ? "PASS ✓" : "FAIL ✗");

    // Test 3: WRONG should have larger spread
    bool test3 = (stddev_wrong > stddev_correct);
    printf("Test 3 - WRONG has larger spread: %s (%.2f > %.2f)\n",
           test3 ? "PASS ✓" : "FAIL ✗", stddev_wrong, stddev_correct);

    // Test 4: Individual probe errors for WRONG
    printf("\nTest 4 - Individual Probe Errors (WRONG):\n");
    bool all_individual_wrong = true;
    for(int i = 1; i < 4; i++) {  // Skip first (no previous delay)
        int64_t expected_error = probe_delays[i-1] - probe_delays[i];  // Previous - Current
        int64_t actual_error = samples[i].offset_wrong - samples[i].offset_correct;
        bool match = (expected_error == actual_error);
        printf("  Probe %d: expected_error=%lld, actual_error=%lld: %s\n",
               i, (long long)expected_error, (long long)actual_error, match ? "✓" : "✗");
        if(!match) all_individual_wrong = false;
    }
    printf("Test 4 - Individual errors match prediction: %s\n", all_individual_wrong ? "PASS ✓" : "FAIL ✗");

    printf("\n=== Final Verdict ===\n");
    if(test1 && test2 && test3 && all_individual_wrong) {
        printf("✓ ALL TESTS PASSED\n");
        printf("✓ Test successfully detects when WRONG (previous delay) is used\n");
        printf("✓ V2 implementation MUST use CURRENT delay to pass this test\n");
        return 0;
    } else {
        printf("✗ SOME TESTS FAILED\n");
        return 1;
    }
}
