// V2 Bootstrap Recovery Test
// Tests coordinator behavior when broadcaster fails to activate
// Verifies 10s grace period and 30s recovery timeout

#include <stdio.h>
#include <stdint.h>
#include <string.h>

// Mock timing constants from cluster_espnow_radio.cpp
constexpr uint32_t kSuppressionDelayMs = 10000U;  // V2: Extended grace period
constexpr uint32_t kRecoveryTimeoutMs = 30000U;   // V2: Recovery timeout

struct CoordinatorState {
    bool grantedLeaseActive = false;
    uint32_t suppressionStartMs = 0;
    uint32_t leaseTransaction = 0;
    uint64_t leaseBroadcasterTag = 0;
    uint64_t leaseBroadcasterBoot = 0;
    uint32_t leaseExpiresMs = 0;
    uint32_t beaconsSuppressed = 0;
};

// Simulate coordinator beacon decision logic
enum class BeaconDecision {
    SEND,           // Send beacon
    SUPPRESS,       // Suppress (broadcaster active)
    REVOKE_RESUME   // Revoke lease and resume beacons
};

BeaconDecision coordinatorBeaconLogic(CoordinatorState& state, uint32_t now) {
    if (state.grantedLeaseActive && state.suppressionStartMs && now >= state.suppressionStartMs) {
        // Check recovery timeout
        if (now >= state.suppressionStartMs + kRecoveryTimeoutMs) {
            // RECOVERY: Broadcaster failed to activate
            printf("  [T=%u] Recovery triggered - revoking lease\n", now);
            state.grantedLeaseActive = false;
            state.suppressionStartMs = 0;
            state.leaseTransaction = 0;
            state.leaseBroadcasterTag = 0;
            state.leaseBroadcasterBoot = 0;
            state.leaseExpiresMs = 0;
            return BeaconDecision::REVOKE_RESUME;
        } else {
            // Suppress during grace + bootstrap period
            state.beaconsSuppressed++;
            return BeaconDecision::SUPPRESS;
        }
    }
    return BeaconDecision::SEND;
}

int main() {
    printf("=== V2 Bootstrap Recovery Test ===\n\n");

    bool allPass = true;

    // Test 1: Grace Period (10s)
    printf("Test 1 - Grace Period (10s):\n");
    {
        CoordinatorState state;
        state.grantedLeaseActive = true;
        state.suppressionStartMs = 10000;  // Suppression starts at T=10000 (grant sent at T=0 + 10s grace)
        state.leaseTransaction = 123;

        // T=0-9999: During grace period (beacons sent)
        printf("  T=0-9999: During grace period (beacons sent)\n");
        auto decision = coordinatorBeaconLogic(state, 5000);
        bool test1a = (decision == BeaconDecision::SEND);
        printf("    Decision at T=5000: %s (expected SEND)\n",
               decision == BeaconDecision::SEND ? "SEND" :
               decision == BeaconDecision::SUPPRESS ? "SUPPRESS" : "REVOKE_RESUME");

        // T=10000: Suppression begins
        printf("  T=10000+: After grace period (suppression begins)\n");
        decision = coordinatorBeaconLogic(state, 10000);
        bool test1b = (decision == BeaconDecision::SUPPRESS);
        printf("    Decision at T=10000: %s (expected SUPPRESS)\n",
               decision == BeaconDecision::SEND ? "SEND" :
               decision == BeaconDecision::SUPPRESS ? "SUPPRESS" : "REVOKE_RESUME");

        // T=15000: Still suppressing
        printf("  T=15000: Still suppressing\n");
        decision = coordinatorBeaconLogic(state, 15000);
        bool test1c = (decision == BeaconDecision::SUPPRESS);
        printf("    Decision at T=15000: %s (expected SUPPRESS)\n",
               decision == BeaconDecision::SEND ? "SEND" :
               decision == BeaconDecision::SUPPRESS ? "SUPPRESS" : "REVOKE_RESUME");

        bool test1 = test1a && test1b && test1c;
        printf("  Result: %s\n\n", test1 ? "PASS ✓" : "FAIL ✗");
        allPass &= test1;
    }

    // Test 2: Recovery Timeout (30s after suppression)
    printf("Test 2 - Recovery Timeout (30s):\n");
    {
        CoordinatorState state;
        state.grantedLeaseActive = true;
        state.suppressionStartMs = 10000;  // Suppression started at T=10000
        state.leaseTransaction = 123;
        state.leaseBroadcasterTag = 0x1234567890ABCDEFULL;

        // T=10000-39999: Suppressing
        printf("  T=10000-39999: Suppressing (waiting for broadcaster)\n");
        auto decision = coordinatorBeaconLogic(state, 25000);
        bool test2a = (decision == BeaconDecision::SUPPRESS && state.grantedLeaseActive);
        printf("    Decision at T=25000: %s, lease still active: %s\n",
               decision == BeaconDecision::SEND ? "SEND" :
               decision == BeaconDecision::SUPPRESS ? "SUPPRESS" : "REVOKE_RESUME",
               state.grantedLeaseActive ? "yes" : "no");

        // T=40000: Recovery timeout reached
        printf("  T=40000+: Recovery timeout (30s after suppression start)\n");
        decision = coordinatorBeaconLogic(state, 40000);
        bool test2b = (decision == BeaconDecision::REVOKE_RESUME);
        bool test2c = (!state.grantedLeaseActive);  // Lease should be revoked
        bool test2d = (state.suppressionStartMs == 0);  // Suppression cleared
        bool test2e = (state.leaseTransaction == 0);  // Transaction cleared

        printf("    Decision at T=40000: %s (expected REVOKE_RESUME)\n",
               decision == BeaconDecision::SEND ? "SEND" :
               decision == BeaconDecision::SUPPRESS ? "SUPPRESS" : "REVOKE_RESUME");
        printf("    Lease revoked: %s (expected yes)\n", !state.grantedLeaseActive ? "yes" : "no");
        printf("    State cleared: suppression=%u txn=%u (expected 0, 0)\n",
               state.suppressionStartMs, state.leaseTransaction);

        // T=40100: Should resume sending beacons
        printf("  T=40100: After recovery (should send beacons)\n");
        decision = coordinatorBeaconLogic(state, 40100);
        bool test2f = (decision == BeaconDecision::SEND);
        printf("    Decision at T=40100: %s (expected SEND)\n",
               decision == BeaconDecision::SEND ? "SEND" :
               decision == BeaconDecision::SUPPRESS ? "SUPPRESS" : "REVOKE_RESUME");

        bool test2 = test2a && test2b && test2c && test2d && test2e && test2f;
        printf("  Result: %s\n\n", test2 ? "PASS ✓" : "FAIL ✗");
        allPass &= test2;
    }

    // Test 3: Timing Verification
    printf("Test 3 - Timing Verification:\n");
    {
        printf("  Grace period: %u ms (allows multiple series attempts)\n", kSuppressionDelayMs);
        printf("  Recovery timeout: %u ms (from suppression start)\n", kRecoveryTimeoutMs);
        printf("  Total bootstrap window: %u ms (grace + recovery)\n",
               kSuppressionDelayMs + kRecoveryTimeoutMs);

        bool test3a = (kSuppressionDelayMs >= 10000);  // At least 10s
        bool test3b = (kRecoveryTimeoutMs >= 30000);   // At least 30s
        bool test3c = (kSuppressionDelayMs + kRecoveryTimeoutMs >= 40000);  // Total >= 40s

        printf("  Grace >= 10s: %s\n", test3a ? "yes ✓" : "no ✗");
        printf("  Recovery >= 30s: %s\n", test3b ? "yes ✓" : "no ✗");
        printf("  Total >= 40s: %s\n", test3c ? "yes ✓" : "no ✗");

        bool test3 = test3a && test3b && test3c;
        printf("  Result: %s\n\n", test3 ? "PASS ✓" : "FAIL ✗");
        allPass &= test3;
    }

    // Test 4: Suppression Counter
    printf("Test 4 - Suppression Counter:\n");
    {
        CoordinatorState state;
        state.grantedLeaseActive = true;
        state.suppressionStartMs = 1000;

        // Suppress 10 times
        for (int i = 0; i < 10; i++) {
            coordinatorBeaconLogic(state, 1000 + i * 100);
        }

        bool test4 = (state.beaconsSuppressed == 10);
        printf("  Suppressed count after 10 cycles: %u (expected 10)\n", state.beaconsSuppressed);
        printf("  Result: %s\n\n", test4 ? "PASS ✓" : "FAIL ✗");
        allPass &= test4;
    }

    // Final verdict
    printf("=== Final Verdict ===\n");
    if (allPass) {
        printf("✓ ALL TESTS PASSED\n");
        printf("✓ 10s grace period allows broadcaster bootstrap\n");
        printf("✓ 30s recovery timeout prevents permanent deadlock\n");
        printf("✓ Coordinator automatically resumes if broadcaster fails\n");
        printf("✓ V2 bootstrap logic verified\n");
        return 0;
    } else {
        printf("✗ SOME TESTS FAILED\n");
        printf("V2 bootstrap logic has issues!\n");
        return 1;
    }
}
