// Host test: SFJC1 optional test-pulse field and passive GPIO meter event grouping.
//   g++ -std=c++17 -Wall -Wextra -I. -x c++ test_cluster_capture_pulse.cpp.test -o /tmp/test_cluster_capture_pulse
// Uses the real pure headers cluster_capture_options.h, cluster_hw_time_event.h
// and cluster_hw_time_math.h.

#include <stdio.h>
#include <string>
#include <vector>
#include "cluster_capture_options.h"
#include "cluster_hw_time_event.h"
#include "cluster_hw_time_math.h"

static int g_failures = 0;
#define CHECK(cond, msg) do { if (cond) printf("  PASS %s\n", msg); \
    else { printf("  FAIL %s (line %d)\n", msg, __LINE__); ++g_failures; } } while (0)

// Mirrors the coordinator's command builder and splitFields() ('|' tokens).
static std::string buildCommand(bool testPulse) {
    std::string cmd = "SFJC1|tag|sf-coord|0000abcd|7|sf-node|00001234|42|1792453661000000";
    if (testPulse) cmd += std::string("|") + ClusterCaptureOptions::kTestPulseToken;
    return cmd;
}
static std::vector<std::string> split(const std::string &s) {
    std::vector<std::string> out; size_t start = 0;
    for (;;) {
        size_t p = s.find('|', start);
        out.push_back(s.substr(start, p - start));
        if (p == std::string::npos) break;
        start = p + 1;
    }
    return out;
}
static bool parseFields(const std::vector<std::string> &f, bool &tp) {
    std::vector<const char *> ptr; for (auto &x : f) ptr.push_back(x.c_str());
    return ClusterCaptureOptions::parse(ptr.size(), ptr.data(), tp);
}
static ClusterHwTimeEvent::Observed obs(std::initializer_list<int64_t> us, std::initializer_list<bool> rx,
                                        std::initializer_list<uint32_t> rises) {
    ClusterHwTimeEvent::Observed o = {};
    int i = 0; for (auto v : us) o.firstRiseUs[i++] = v;
    i = 0; for (auto v : rx) o.received[i++] = v;
    i = 0; for (auto v : rises) o.rises[i++] = v;
    return o;
}

int main() {
    printf("=== SFJC1 optional test pulse field ===\n");
    printf("T1 default command is the unchanged 9-field format\n");
    { const std::string c = buildCommand(false);
      CHECK(c == "SFJC1|tag|sf-coord|0000abcd|7|sf-node|00001234|42|1792453661000000", "byte-identical default packet");
      bool tp = true; CHECK(parseFields(split(c), tp) && !tp, "9 fields accepted, no pulse"); }
    printf("T2 explicit request adds exactly one trailing field\n");
    { const auto f = split(buildCommand(true)); bool tp = false;
      CHECK(f.size() == 10 && f[9] == "tp1", "10th field is tp1");
      CHECK(parseFields(f, tp) && tp, "10 fields with tp1 accepted, pulse requested"); }
    printf("T3 every other layout is rejected (no silent reinterpretation)\n");
    { bool tp = false; auto f = split(buildCommand(true)); f[9] = "tp2";
      CHECK(!parseFields(f, tp) && !tp, "unknown option token rejected");
      f[9] = ""; CHECK(!parseFields(f, tp), "empty option rejected");
      f = split(buildCommand(true)); f.push_back("x"); CHECK(!parseFields(f, tp), "11 fields rejected");
      f = split(buildCommand(false)); f.pop_back(); CHECK(!parseFields(f, tp), "8 fields rejected");
      CHECK(!ClusterCaptureOptions::parse(10, nullptr, tp), "null field list rejected"); }
    printf("T4 legacy node rule (n != 9 -> drop) drops the extended packet\n");
    { CHECK(split(buildCommand(true)).size() != 9, "old firmware sees 10 fields and ignores the job");
      CHECK(split(buildCommand(false)).size() == 9, "old firmware still accepts default jobs"); }

    printf("=== Passive GPIO meter event grouping ===\n");
    const int64_t W = 500000;
    printf("T5 nothing received -> no event\n");
    { auto o = obs({0, 0, 0}, {false, false, false}, {0, 0, 0}); ClusterHwTimeEvent::Event e;
      CHECK(!ClusterHwTimeEvent::ready(o, 10000000, W), "not ready");
      CHECK(!ClusterHwTimeEvent::close(o, W, e), "close returns false"); }
    printf("T6 two nodes 420 us apart, closed after the window\n");
    { auto o = obs({1000420, 1000000, 0}, {true, true, false}, {1, 1, 0});
      CHECK(!ClusterHwTimeEvent::ready(o, 1000000 + W - 1, W), "still inside window");
      CHECK(ClusterHwTimeEvent::ready(o, 1000000 + W, W), "ready at window end");
      ClusterHwTimeEvent::Event e; CHECK(ClusterHwTimeEvent::close(o, W, e), "closed");
      CHECK(e.firstEdgeUs == 1000000, "reference = earliest edge");
      CHECK(e.present[0] && e.present[1] && !e.present[2] && e.lateEdges == 0, "channels 1+2 present");
      ClusterHwTimeMath::Sample s = {}; s.referenceUs = e.firstEdgeUs;
      for (int i = 0; i < 3; ++i) { s.nodeUs[i] = e.edgeUs[i]; s.present[i] = e.present[i]; }
      auto r = ClusterHwTimeMath::compare(s);
      CHECK(r.pairValid[0] && r.pairOffsetMs[0] > 0.4199 && r.pairOffsetMs[0] < 0.4201, "ch1-ch2 = +0.420 ms");
      CHECK(!r.pairValid[1] && !r.pairValid[2], "pairs with missing channel invalid");
      CHECK(r.offsetMs[1] == 0.0, "earliest channel offset 0"); }
    printf("T7 edge outside the window is not attributed; double edges are counted\n");
    { auto o = obs({2000000, 2000000 + W + 1, 2000050}, {true, true, true}, {2, 1, 1});
      ClusterHwTimeEvent::Event e; ClusterHwTimeEvent::close(o, W, e);
      CHECK(e.present[0] && !e.present[1] && e.present[2], "late channel excluded");
      CHECK(e.lateEdges == 1, "late edge counted");
      CHECK(e.rises[0] == 2, "double trigger visible in rise count"); }
    printf("T8 simultaneous edges -> zero difference; reference follows the earliest channel\n");
    { auto o = obs({3000000, 3000000, 2999900}, {true, true, true}, {1, 1, 1});
      ClusterHwTimeEvent::Event e; ClusterHwTimeEvent::close(o, W, e);
      ClusterHwTimeMath::Sample s = {}; s.referenceUs = e.firstEdgeUs;
      for (int i = 0; i < 3; ++i) { s.nodeUs[i] = e.edgeUs[i]; s.present[i] = e.present[i]; }
      auto r = ClusterHwTimeMath::compare(s);
      CHECK(e.firstEdgeUs == 2999900, "channel 3 earliest");
      CHECK(r.pairOffsetMs[0] == 0.0, "ch1-ch2 = 0");
      CHECK(r.pairOffsetMs[1] > 0.0999 && r.pairOffsetMs[1] < 0.1001, "ch1-ch3 = +0.100 ms");
      CHECK(r.pairOffsetMs[2] > 0.0999 && r.pairOffsetMs[2] < 0.1001, "ch2-ch3 = +0.100 ms"); }

    printf("T9 only qualified channels form a precision result\n");
    { auto o = obs({4000000, 4000300, 0}, {true, true, false}, {1, 1, 0});
      ClusterHwTimeEvent::Event e; ClusterHwTimeEvent::close(o, W, e);
      CHECK(ClusterHwTimeEvent::qualified(e, 0) && ClusterHwTimeEvent::qualified(e, 1), "clean pair qualified");
      CHECK(!ClusterHwTimeEvent::qualified(e, 2), "missing channel never qualified");
      CHECK(!ClusterHwTimeEvent::qualified(e, -1) && !ClusterHwTimeEvent::qualified(e, 3), "out-of-range channel rejected");
      auto d = obs({4000000, 4000300, 0}, {true, true, false}, {2, 1, 0});
      ClusterHwTimeEvent::close(d, W, e);
      CHECK(!ClusterHwTimeEvent::qualified(e, 0) && ClusterHwTimeEvent::qualified(e, 1), "double edge disqualifies its channel");
      auto l = obs({4000000, 4000300, 4000000 + W + 5}, {true, true, true}, {1, 1, 1});
      ClusterHwTimeEvent::close(l, W, e);
      CHECK(!ClusterHwTimeEvent::qualified(e, 0) && !ClusterHwTimeEvent::qualified(e, 1), "late edge disqualifies the whole event");
      auto z = obs({4000000, 4000300, 0}, {true, true, false}, {0, 1, 0});
      ClusterHwTimeEvent::close(z, W, e);
      CHECK(!ClusterHwTimeEvent::qualified(e, 0), "inconsistent zero rise count rejected"); }

    printf("=== %s (%d failures) ===\n", g_failures ? "FAILED" : "ALL PASSED", g_failures);
    return g_failures ? 1 : 0;
}
