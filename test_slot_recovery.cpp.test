// Host test: recovery slot for the ESP-NOW precision slot rotation.
//
// Uses the REAL decision functions from cluster_slot_recovery.h (also called by
// cluster_espnow_radio.cpp serviceSlots/endSlot/acceptNodeReport). The coordinator
// slot loop below mirrors serviceSlots()/endSlot() (owner slot 14 s, guard 3.5 s,
// peer active 30 s, 12-entry peer table); nodes are a simplified model: a node
// measures once ~1 s after it receives a grant (its nextSeriesMs is re-armed to
// now+1 s while it holds no permission), the series ends 1 s later, it reports its
// precision age in whole seconds every 5 s and its precision expires after 120 s.
// Every scenario runs with recovery disabled (old behaviour) and enabled.
//
// Build & run (host):
//   g++ -std=c++17 -Wall -Wextra -I. -x c++ test_slot_recovery.cpp.test -o /tmp/test_slot_recovery
//   /tmp/test_slot_recovery

#include <stdio.h>
#include <stdint.h>
#include <vector>
#include <functional>
#include "cluster_slot_recovery.h"

using namespace ClusterSlotRecovery;

static int g_failures = 0;
#define CHECK(cond, msg) do { if (cond) printf("  PASS %s\n", msg); \
    else { printf("  FAIL %s (line %d)\n", msg, __LINE__); ++g_failures; } } while (0)

constexpr uint32_t kOwnerSlotMs = 14000, kSlotGuardMs = 3500, kPeerActiveMs = 30000;
constexpr uint32_t kLifetimeMs = 120000, kReportEveryMs = 5000, kStepMs = 100;
constexpr Params kParams{kOwnerSlotMs + kSlotGuardMs, kOwnerSlotMs, kLifetimeMs};

// outcome(node, seriesIndex) -> true = accepted series
using Outcome = std::function<bool(int, int)>;

struct Node {
    bool online = true;
    uint32_t boot = 1;
    bool hasPrecision = false;
    uint32_t lastSuccessMs = 0;
    int series = 0;
    bool measuredThisGrant = false;
    uint32_t seriesDoneAtMs = 0;   // pending series completion, 0 = none
    uint32_t reportPhaseMs = 0;
    // results
    uint64_t fallbackMs = 0;        // time with a former estimate that has expired
    uint32_t fallbackEvents = 0;
    bool inFallback = false;
    uint32_t lastRegularSlotMs = 0;
    uint32_t maxRegularGapMs = 0;
    uint32_t regularSlots = 0, recoverySlots = 0, recoverySinceRegular = 0;
    uint32_t maxRecoveryPerCycle = 0;
};

struct Peer { int node = -1; uint32_t boot = 0; uint32_t seenMs = 0; PeerState rec; };

struct Sim {
    bool recoveryEnabled;
    size_t capacity;
    std::vector<Node> nodes;
    std::vector<Peer> peers;
    Outcome outcome;
    uint8_t nextIndex = 0;
    int owner = -1;
    bool ownerRecovery = false, lastWasRecovery = false;
    uint32_t slotStartMs = 0, guardUntilMs = kSlotGuardMs;
    Stats stats;
    // invariant tracking
    bool overlap = false;
    uint32_t lastSlotEndMs = 0;
    uint32_t consecutiveRecovery = 0, maxConsecutiveRecovery = 0;
    std::vector<int> ownerLog;      // node index per granted slot (recovery = -(node+1))

    Sim(size_t n, bool enabled, Outcome o, size_t cap = 12)
        : recoveryEnabled(enabled), capacity(cap), nodes(n), peers(cap), outcome(o) {
        for (size_t i = 0; i < n; ++i) nodes[i].reportPhaseMs = (uint32_t)((i * 1300) % kReportEveryMs);
    }

    void notePeer(int node, uint32_t now) {   // mirrors noteSlotPeer()
        const uint32_t boot = nodes[node].boot;
        for (size_t i = 0; i < capacity; ++i) {
            Peer &p = peers[i];
            if (p.boot && p.node == node) {
                if (p.boot != boot && owner == (int)i) {
                    lastWasRecovery = ownerRecovery; ownerRecovery = false;
                    owner = -1; guardUntilMs = now + kSlotGuardMs;
                }
                if (p.boot != boot) p.rec = {};
                p.boot = boot; p.seenMs = now; return;
            }
        }
        for (size_t i = 0; i < capacity; ++i) {
            Peer &p = peers[i];
            if (!p.boot || now - p.seenMs > kPeerActiveMs) {
                p = {}; p.node = node; p.boot = boot; p.seenMs = now; return;
            }
        }
    }
    void endSlot(uint32_t now) {               // mirrors endSlot()
        if (owner >= 0) {
            if (!ownerRecovery) nextIndex = (uint8_t)((owner + 1) % capacity);
            lastWasRecovery = ownerRecovery;
            lastSlotEndMs = now;
        }
        owner = -1; ownerRecovery = false; guardUntilMs = now + kSlotGuardMs;
    }
    void coordinatorReset(uint32_t now) {      // radio stop()/start() on coordinator change
        for (auto &p : peers) p = {};
        nextIndex = 0; owner = -1; ownerRecovery = lastWasRecovery = false;
        guardUntilMs = now + kSlotGuardMs; stats = {}; lastSlotEndMs = 0;
    }
    void serviceSlots(uint32_t now) {          // mirrors serviceSlots()
        if (owner >= 0 && (now - slotStartMs >= kOwnerSlotMs ||
                           now - peers[owner].seenMs > kPeerActiveMs)) endSlot(now);
        if (owner >= 0 || !reached(now, guardUntilMs)) return;
        std::vector<uint8_t> order; std::vector<PeerState *> ordered;
        for (size_t off = 0; off < capacity; ++off) {
            const uint8_t i = (uint8_t)((nextIndex + off) % capacity);
            if (peers[i].boot && now - peers[i].seenMs <= kPeerActiveMs) {
                order.push_back(i); ordered.push_back(&peers[i].rec);
            }
        }
        if (order.empty()) return;
        const int r = recoveryEnabled ?
            choose(ordered.data(), ordered.size(), lastWasRecovery, now, kParams, stats) : -1;
        ownerRecovery = r > 0;
        owner = order[ownerRecovery ? r : 0];
        onSlotStart(peers[owner].rec, ownerRecovery, now, stats);
        if (lastSlotEndMs && now < lastSlotEndMs + kSlotGuardMs) overlap = true;
        slotStartMs = now;
        Node &n = nodes[peers[owner].node];
        n.measuredThisGrant = false;
        if (ownerRecovery) {
            ++n.recoverySlots; ++n.recoverySinceRegular;
            if (n.recoverySinceRegular > n.maxRecoveryPerCycle) n.maxRecoveryPerCycle = n.recoverySinceRegular;
            ++consecutiveRecovery;
            if (consecutiveRecovery > maxConsecutiveRecovery) maxConsecutiveRecovery = consecutiveRecovery;
            ownerLog.push_back(-(peers[owner].node + 1));
        } else {
            if (n.lastRegularSlotMs && now - n.lastRegularSlotMs > n.maxRegularGapMs)
                n.maxRegularGapMs = now - n.lastRegularSlotMs;
            n.lastRegularSlotMs = now; ++n.regularSlots; n.recoverySinceRegular = 0;
            consecutiveRecovery = 0;
            ownerLog.push_back(peers[owner].node);
        }
    }
    int ownerNode() const { return owner >= 0 ? peers[owner].node : -1; }

    void step(uint32_t now) {
        serviceSlots(now);
        const int on = ownerNode();
        for (size_t i = 0; i < nodes.size(); ++i) {
            Node &n = nodes[i];
            if (!n.online) continue;
            // Series: starts ~1 s after the grant, completes 1 s later; needs permission.
            if ((int)i == on && !n.measuredThisGrant && now - slotStartMs >= 1000) {
                n.measuredThisGrant = true; n.seriesDoneAtMs = now + 1000;
            }
            if (n.seriesDoneAtMs && reached(now, n.seriesDoneAtMs)) {
                n.seriesDoneAtMs = 0;
                if ((int)i == on) {
                    if (outcome((int)i, n.series)) { n.hasPrecision = true; n.lastSuccessMs = now; }
                    ++n.series;
                }
            }
            // Precision report every 5 s (whole seconds, like sendNodeReports()).
            if (now % kReportEveryMs == n.reportPhaseMs) {
                notePeer((int)i, now);
                for (size_t k = 0; k < capacity; ++k)
                    if (peers[k].boot && peers[k].node == (int)i)
                        onPrecisionReport(peers[k].rec, n.hasPrecision,
                                          n.hasPrecision ? ((now - n.lastSuccessMs) / 1000) * 1000 : 0,
                                          now, kParams, stats);
            }
            const bool expired = n.hasPrecision && now - n.lastSuccessMs > kLifetimeMs;
            if (expired) { n.fallbackMs += kStepMs; if (!n.inFallback) ++n.fallbackEvents; }
            n.inFallback = expired;
        }
    }
    void run(uint32_t from, uint32_t to, std::function<void(uint32_t)> hook = nullptr) {
        for (uint32_t t = from; t < to; t += kStepMs) { if (hook) hook(t); step(t); }
    }
};

static const uint32_t kWarmupMs = 600000;   // 10 min to fill the peer table and estimates
static const uint32_t kRunMs = 4 * 3600000; // 4 h

static Outcome allGood() { return [](int, int) { return true; }; }
// Node `bad` rejects the given series indices (counted from its first series).
static Outcome rejects(int bad, std::vector<int> idx) {
    return [bad, idx](int node, int s) {
        if (node != bad) return true;
        for (int i : idx) if (i == s) return false;
        return true;
    };
}

static uint64_t fallbackOf(const Sim &s, int node) { return s.nodes[node].fallbackMs; }
static uint64_t fallbackOthers(const Sim &s, int except1, int except2 = -1) {
    uint64_t t = 0;
    for (size_t i = 0; i < s.nodes.size(); ++i)
        if ((int)i != except1 && (int)i != except2) t += s.nodes[i].fallbackMs;
    return t;
}
static void commonInvariants(const Sim &s, const char *tag) {
    char m[160];
    snprintf(m, sizeof m, "%s: I1 single owner, guard respected between slots", tag);
    CHECK(!s.overlap, m);
    snprintf(m, sizeof m, "%s: I2 never two recovery slots back to back (max run %u)", tag,
             (unsigned)s.maxConsecutiveRecovery);
    CHECK(s.maxConsecutiveRecovery <= 1, m);
    uint32_t maxPer = 0;
    for (auto &n : s.nodes) if (n.maxRecoveryPerCycle > maxPer) maxPer = n.maxRecoveryPerCycle;
    snprintf(m, sizeof m, "%s: I3 at most one recovery per node and regular cycle", tag);
    CHECK(maxPer <= 1, m);
}
static void printRun(const Sim &s, const char *tag) {
    printf("  [%s] recovery %s: requested=%u granted=%u deferred=%u succeeded=%u failed=%u | fallback s:",
           tag, s.recoveryEnabled ? "on " : "off", s.stats.requested, s.stats.granted,
           s.stats.deferred, s.stats.succeeded, s.stats.failed);
    for (size_t i = 0; i < s.nodes.size() && i < 8; ++i) printf(" %.1f", s.nodes[i].fallbackMs / 1000.0);
    printf("\n");
}

static void scenarioStable(size_t n) {
    char tag[32]; snprintf(tag, sizeof tag, "%zu stable", n);
    printf("\n== %zu node(s), all series accepted\n", n);
    Sim off(n, false, allGood()), on(n, true, allGood());
    off.run(0, kRunMs); on.run(0, kRunMs);
    printRun(off, tag); printRun(on, tag);
    commonInvariants(on, tag);
    char m[160];
    snprintf(m, sizeof m, "%s: no recovery requested or granted", tag);
    CHECK(on.stats.requested == 0 && on.stats.granted == 0, m);
    snprintf(m, sizeof m, "%s: slot order identical to old rotation", tag);
    CHECK(on.ownerLog == off.ownerLog, m);
    snprintf(m, sizeof m, "%s: no WiFi fallback", tag);
    CHECK(fallbackOthers(on, -1) == 0, m);
}

int main() {
    printf("test_slot_recovery: params slot period %u ms, owner %u ms, lifetime %u ms\n",
           kParams.slotPeriodMs, kParams.ownerSlotMs, kParams.lifetimeMs);

    // ---------------------------------------------------------------- unit checks
    printf("\n== needsRecovery / shiftIsSafe unit checks\n");
    {
        PeerState p; p.ageKnown = true; p.hadSlot = true;
        p.lastSlotStartMs = 100000; p.reportRxMs = 115000; p.reportedAgeMs = 85000;
        // age at 117.5 s = 87.5 s, own slot 17.5 s ago -> last slot failed
        CHECK(needsRecovery(p, 3, 117500, kParams), "failed slot, regular slot too late -> recovery");
        CHECK(!needsRecovery(p, 0, 117500, kParams), "node is next regular owner -> no recovery");
        CHECK(!needsRecovery(p, 1, 117500, kParams), "regular slot still in time -> no recovery");
        PeerState ok = p; ok.reportedAgeMs = 13000;   // success inside its last slot
        CHECK(!needsRecovery(ok, 3, 117500, kParams), "last slot succeeded -> no recovery");
        PeerState early = p; early.reportRxMs = 110000;  // report before its slot ended
        CHECK(!needsRecovery(early, 3, 117500, kParams), "outcome unknown (report before slot end) -> wait");
        PeerState used = p; used.recoveryUsed = true;
        CHECK(!needsRecovery(used, 3, 117500, kParams), "recovery already used this cycle -> no");
        PeerState gone = p; gone.reportedAgeMs = 119000;
        CHECK(!needsRecovery(gone, 3, 117500, kParams), "estimate already expired -> regular fallback path");
        PeerState none = p; none.ageKnown = false;
        CHECK(!needsRecovery(none, 3, 117500, kParams), "no precision reported -> no recovery");
        // I4: a node exactly safe now but too late after a one-slot shift blocks recovery
        PeerState victim; victim.ageKnown = true; victim.reportRxMs = 117500; victim.reportedAgeMs = 90000;
        PeerState *ord[4] = {&victim, &ok, &ok, &p};
        CHECK(!shiftIsSafe(ord, 4, 3, 117500, kParams), "shift that would expire a healthy node is refused");
        victim.reportedAgeMs = 60000;
        CHECK(shiftIsSafe(ord, 4, 3, 117500, kParams), "shift with enough margin is allowed");
        Stats st;
        PeerState a = p, b = p; b.reportedAgeMs = 86000;
        PeerState ok2 = ok;
        PeerState *two[4] = {&ok, &ok2, &a, &b};   // a, b both need recovery (pos 2, 3)
        CHECK(choose(two, 4, false, 117500, kParams, st) == 3, "two needs: oldest estimate wins (deterministic)");
        b.reportedAgeMs = a.reportedAgeMs;
        CHECK(choose(two, 4, false, 117500, kParams, st) == 2, "two needs, equal age: earlier rotation position wins");
        CHECK(choose(two, 4, true, 117500, kParams, st) == -1, "after a recovery slot the regular owner comes first");
        PeerState *notAtRisk[4] = {&ok, &a, &ok2, &ok};
        CHECK(choose(notAtRisk, 4, false, 117500, kParams, st) == -1,
              "failed node whose regular slot still ends in time -> no recovery");
        // millis() wrap
        PeerState w = p;
        const uint32_t base = 0xFFFF0000u;
        w.lastSlotStartMs = base; w.reportRxMs = base + 15000; w.reportedAgeMs = 85000;
        CHECK(needsRecovery(w, 3, base + 17500, kParams), "decision stable across millis() wrap");
    }

    // ---------------------------------------------------------------- scenarios
    scenarioStable(1);
    scenarioStable(2);
    scenarioStable(4);

    {
        printf("\n== 4 nodes, node 2 rejects exactly one series\n");
        Sim off(4, false, rejects(2, {20})), on(4, true, rejects(2, {20}));
        off.run(0, kRunMs); on.run(0, kRunMs);
        printRun(off, "1 reject"); printRun(on, "1 reject");
        commonInvariants(on, "1 reject");
        CHECK(fallbackOf(off, 2) > 0, "old rotation: single rejection causes WiFi fallback");
        CHECK(fallbackOf(on, 2) == 0, "recovery: single rejection no longer causes fallback");
        CHECK(on.stats.granted == 1 && on.stats.succeeded == 1, "exactly one recovery slot, reported successful");
        CHECK(fallbackOthers(on, 2) == 0, "other nodes unaffected");
    }
    {
        printf("\n== 4 nodes, node 2 rejects four series in a row\n");
        Sim off(4, false, rejects(2, {20, 21, 22, 23})), on(4, true, rejects(2, {20, 21, 22, 23}));
        off.run(0, kRunMs); on.run(0, kRunMs);
        printRun(off, "4 rejects"); printRun(on, "4 rejects");
        commonInvariants(on, "4 rejects");
        CHECK(fallbackOf(on, 2) > 0, "persistent rejections: regular fallback still happens");
        CHECK(on.stats.granted <= 2, "recovery bounded (no endless recovery cycle)");
        CHECK(fallbackOthers(on, 2) == 0, "other nodes keep precision");
    }
    {
        printf("\n== 4 nodes, nodes 1 and 3 reject one series in the same rotation\n");
        auto o = [](int node, int s) { return !((node == 1 || node == 3) && s == 20); };
        Sim off(4, false, o), on(4, true, o);
        off.run(0, kRunMs); on.run(0, kRunMs);
        printRun(off, "2 need"); printRun(on, "2 need");
        commonInvariants(on, "2 need");
        CHECK(on.stats.granted >= 1, "at least one of the two nodes gets a recovery slot");
        CHECK(fallbackOf(on, 1) + fallbackOf(on, 3) < fallbackOf(off, 1) + fallbackOf(off, 3),
              "total fallback of the affected nodes is reduced");
        CHECK(fallbackOthers(on, 1, 3) == 0, "unaffected nodes keep precision");
        Sim on2(4, true, o); on2.run(0, kRunMs);
        CHECK(on2.ownerLog == on.ownerLog, "deterministic: identical slot sequence on repeat");
    }
    {
        printf("\n== 4 nodes, node 0 permanently bad after warm-up\n");
        auto o = [](int node, int s) { return node != 0 || s < 8; };
        Sim on(4, true, o), off(4, false, o);
        on.run(0, kRunMs); off.run(0, kRunMs);
        printRun(off, "bad node"); printRun(on, "bad node");
        commonInvariants(on, "bad node");
        CHECK(fallbackOthers(on, 0) == 0, "a bad node does not cost other nodes their precision");
        uint32_t maxGap = 0;
        for (int i = 1; i < 4; ++i) if (on.nodes[i].maxRegularGapMs > maxGap) maxGap = on.nodes[i].maxRegularGapMs;
        printf("  max regular slot gap of good nodes: %.1f s (old rotation 70 s)\n", maxGap / 1000.0);
        CHECK(maxGap <= 5 * kParams.slotPeriodMs, "good nodes delayed by at most one slot per cycle");
        CHECK(on.stats.granted <= 1, "a node without valid estimate gets no endless recovery");
    }
    {
        printf("\n== 4 nodes, node 1 disappears during its slot\n");
        Sim on(4, true, allGood());
        bool cut = false;
        on.run(0, kRunMs, [&](uint32_t t) {
            if (!cut && t > kWarmupMs && on.ownerNode() == 1) { on.nodes[1].online = false; cut = true; }
        });
        printRun(on, "vanish");
        commonInvariants(on, "vanish");
        CHECK(cut, "node went offline while owning the slot");
        CHECK(fallbackOthers(on, 1) == 0, "remaining nodes keep precision");
        CHECK(on.stats.granted == 0, "no recovery for a vanished node");
    }
    {
        printf("\n== 4 nodes, coordinator restart during a recovery slot\n");
        Sim on(4, true, rejects(2, {20}));
        bool reset = false;
        on.run(0, kRunMs, [&](uint32_t t) {
            if (!reset && on.ownerRecovery) { on.coordinatorReset(t); reset = true; }
        });
        printRun(on, "coord reset");
        commonInvariants(on, "coord reset");
        CHECK(reset, "coordinator state reset while a recovery slot was active");
        CHECK(on.owner >= 0 || on.ownerLog.size() > 10, "rotation resumes after the reset");
        CHECK(on.stats.granted == 0 || on.stats.requested >= on.stats.granted, "counters consistent after reset");
    }
    {
        printf("\n== 4 nodes, node 2 reboots (new boot id) after a rejection\n");
        Sim on(4, true, rejects(2, {20}));
        bool rebooted = false;
        on.run(0, kRunMs, [&](uint32_t t) {
            Node &n = on.nodes[2];
            if (!rebooted && n.series == 21 && on.ownerNode() != 2) {
                n.boot = 2; n.hasPrecision = false; n.lastSuccessMs = 0; rebooted = true; (void)t;
            }
        });
        printRun(on, "reboot");
        commonInvariants(on, "reboot");
        CHECK(rebooted, "node rebooted");
        CHECK(on.stats.granted == 0, "rebooted node has no estimate -> no recovery, state reset");
        CHECK(fallbackOthers(on, 2) == 0, "other nodes unaffected");
    }
    {
        printf("\n== 4 nodes, recovery series also rejected\n");
        Sim on(4, true, rejects(2, {20, 21}));
        on.run(0, kRunMs);
        printRun(on, "recovery fails");
        commonInvariants(on, "recovery fails");
        CHECK(on.stats.granted == 1 && on.stats.failed == 1, "one recovery slot, reported failed");
        CHECK(fallbackOf(on, 2) > 0, "regular WiFi fallback still happens");
        CHECK(on.nodes[2].fallbackEvents == 1, "precision returns with the next accepted series");
        CHECK(fallbackOthers(on, 2) == 0, "other nodes unaffected");
    }

    // ---------------------------------------------------------------- scaling model
    printf("\n== scaling model (each node rejects every 50th series)\n");
    for (size_t n : {4u, 5u, 6u, 10u, 12u, 100u}) {
        const size_t cap = n > 12 ? n : 12;
        auto o = [](int node, int s) { return (s + node * 7) % 50 != 49; };
        Sim off(n, false, o, cap), on(n, true, o, cap);
        const uint32_t dur = n >= 100 ? 6 * 3600000u : kRunMs;
        off.run(0, dur); on.run(0, dur);
        uint64_t fbOff = 0, fbOn = 0, maxGap = 0; uint32_t starving = 0;
        for (size_t i = 0; i < n; ++i) {
            fbOff += off.nodes[i].fallbackMs; fbOn += on.nodes[i].fallbackMs;
            if (on.nodes[i].maxRegularGapMs > maxGap) maxGap = on.nodes[i].maxRegularGapMs;
            if (!on.nodes[i].regularSlots) ++starving;
        }
        const double total = (double)n * (dur - kWarmupMs);
        printf("  N=%3zu cycle %6.1f s | fallback share off %5.1f %% on %5.1f %% | recovery granted %u deferred %u"
               " | max regular gap %.1f s | nodes without slot %u\n",
               n, n * kParams.slotPeriodMs / 1000.0, 100.0 * fbOff / total, 100.0 * fbOn / total,
               on.stats.granted, on.stats.deferred, maxGap / 1000.0, starving);
        char m[160];
        snprintf(m, sizeof m, "N=%zu: invariants hold", n);
        CHECK(!on.overlap && on.maxConsecutiveRecovery <= 1, m);
        snprintf(m, sizeof m, "N=%zu: recovery never increases total fallback", n);
        CHECK(fbOn <= fbOff, m);
        snprintf(m, sizeof m, "N=%zu: every node keeps getting regular slots (gap <= 2 cycles)", n);
        CHECK(starving == 0 && maxGap <= 2 * n * kParams.slotPeriodMs, m);
    }
    {
        printf("\n== 100 nodes with the real 12-entry peer table\n");
        Sim on(100, true, allGood(), 12);
        on.run(0, 2 * 3600000u);
        uint32_t withSlot = 0;
        for (auto &n : on.nodes) if (n.regularSlots) ++withSlot;
        printf("  nodes that ever got a slot: %u of 100\n", withSlot);
        CHECK(withSlot <= 12, "table limit: at most 12 nodes take part (architectural limit, unchanged)");
    }

    printf("\n%s (%d failure%s)\n", g_failures ? "FAILED" : "ALL PASSED", g_failures,
           g_failures == 1 ? "" : "s");
    return g_failures ? 1 : 0;
}
