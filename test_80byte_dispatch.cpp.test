// Beta133: Regression test for 80-byte packet dispatch fix
// Tests that Diagnostic ('SFDB') and Time ('SFEN') packets are correctly routed

#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include <assert.h>

// Mock the dispatch logic from cluster_espnow_radio.cpp:671-734
enum class QueueType {
    NONE,
    DIAGNOSTIC,
    GRANT,
    TIME,
    REJECTED
};

QueueType dispatchPacket(const uint8_t* data, int length) {
    if (!data) return QueueType::REJECTED;

    // Grant frames (96 bytes)
    const int GRANT_SIZE = 96;
    if (length == GRANT_SIZE) {
        return QueueType::GRANT;
    }

    // 80-byte frames - distinguish by magic
    const int WIRE_80_BYTES = 80;
    if (length == WIRE_80_BYTES) {
        // Diagnostic Beacon: magic 'SFDB'
        if (length >= 3 && data[0] == 'S' && data[1] == 'F' && data[2] == 'D') {
            return QueueType::DIAGNOSTIC;
        }
        // Time Packet: magic 'SFEN'
        if (length >= 3 && data[0] == 'S' && data[1] == 'F' && data[2] == 'E') {
            return QueueType::TIME;
        }
        // Invalid magic
        return QueueType::REJECTED;
    }

    // Wrong size
    return QueueType::REJECTED;
}

void testDiagnosticBeacon() {
    printf("Test 1 - Diagnostic Beacon (80 bytes, 'SFDB' magic):\n");

    uint8_t packet[80] = {};
    packet[0] = 'S';
    packet[1] = 'F';
    packet[2] = 'D';  // Diagnostic
    packet[3] = 'B';
    packet[4] = 1;  // Version

    QueueType result = dispatchPacket(packet, 80);
    assert(result == QueueType::DIAGNOSTIC);
    printf("  ✓ Diagnostic beacon → DIAGNOSTIC queue\n\n");
}

void testTimeBeacon() {
    printf("Test 2 - Time Beacon (80 bytes, 'SFEN' magic):\n");

    uint8_t packet[80] = {};
    packet[0] = 'S';
    packet[1] = 'F';
    packet[2] = 'E';  // Time
    packet[3] = 'N';
    packet[4] = 2;  // V2
    packet[5] = 1;  // Type::Beacon

    QueueType result = dispatchPacket(packet, 80);
    assert(result == QueueType::TIME);
    printf("  ✓ Time beacon → TIME queue\n\n");
}

void testTimeProbe() {
    printf("Test 3 - Time Probe (80 bytes, 'SFEN' magic):\n");

    uint8_t packet[80] = {};
    packet[0] = 'S';
    packet[1] = 'F';
    packet[2] = 'E';  // Time
    packet[3] = 'N';
    packet[4] = 2;  // V2
    packet[5] = 2;  // Type::Probe

    QueueType result = dispatchPacket(packet, 80);
    assert(result == QueueType::TIME);
    printf("  ✓ Time probe → TIME queue\n\n");
}

void testGrant() {
    printf("Test 4 - Grant (96 bytes):\n");

    uint8_t packet[96] = {};
    // Grant has its own format, doesn't need magic check

    QueueType result = dispatchPacket(packet, 96);
    assert(result == QueueType::GRANT);
    printf("  ✓ Grant → GRANT queue\n\n");
}

void testInvalidMagic() {
    printf("Test 5 - Invalid magic (80 bytes, wrong magic):\n");

    uint8_t packet[80] = {};
    packet[0] = 'X';  // Wrong magic
    packet[1] = 'Y';
    packet[2] = 'Z';

    QueueType result = dispatchPacket(packet, 80);
    assert(result == QueueType::REJECTED);
    printf("  ✓ Invalid magic → REJECTED\n\n");
}

void testWrongSize() {
    printf("Test 6 - Wrong size (64 bytes):\n");

    uint8_t packet[64] = {};
    packet[0] = 'S';
    packet[1] = 'F';
    packet[2] = 'E';
    packet[3] = 'N';

    QueueType result = dispatchPacket(packet, 64);
    assert(result == QueueType::REJECTED);
    printf("  ✓ Wrong size → REJECTED\n\n");
}

void testNoMisclassification() {
    printf("Test 7 - No cross-classification:\n");

    // Diagnostic magic should not route to TIME
    uint8_t diag[80] = {};
    diag[0] = 'S'; diag[1] = 'F'; diag[2] = 'D'; diag[3] = 'B';
    assert(dispatchPacket(diag, 80) == QueueType::DIAGNOSTIC);
    assert(dispatchPacket(diag, 80) != QueueType::TIME);

    // Time magic should not route to DIAGNOSTIC
    uint8_t time[80] = {};
    time[0] = 'S'; time[1] = 'F'; time[2] = 'E'; time[3] = 'N';
    assert(dispatchPacket(time, 80) == QueueType::TIME);
    assert(dispatchPacket(time, 80) != QueueType::DIAGNOSTIC);

    printf("  ✓ No cross-classification between Diagnostic and Time\n\n");
}

void testMagicByte2Only() {
    printf("Test 8 - Byte 2 alone distinguishes (S,F match, D vs E differs):\n");

    uint8_t packet1[80] = {};
    packet1[0] = 'S'; packet1[1] = 'F'; packet1[2] = 'D'; // Diagnostic

    uint8_t packet2[80] = {};
    packet2[0] = 'S'; packet2[1] = 'F'; packet2[2] = 'E'; // Time

    assert(dispatchPacket(packet1, 80) == QueueType::DIAGNOSTIC);
    assert(dispatchPacket(packet2, 80) == QueueType::TIME);
    assert(dispatchPacket(packet1, 80) != dispatchPacket(packet2, 80));

    printf("  ✓ Byte 2 ('D' vs 'E') correctly distinguishes packet type\n\n");
}

int main() {
    printf("=== Beta133: 80-Byte Packet Dispatch Regression Test ===\n\n");

    testDiagnosticBeacon();
    testTimeBeacon();
    testTimeProbe();
    testGrant();
    testInvalidMagic();
    testWrongSize();
    testNoMisclassification();
    testMagicByte2Only();

    printf("=== All Tests PASSED ✓ ===\n");
    printf("✓ Diagnostic beacons ('SFDB') → Diagnostic queue\n");
    printf("✓ Time packets ('SFEN') → Time queue\n");
    printf("✓ Grant packets (96 bytes) → Grant queue\n");
    printf("✓ Invalid magic/size → Rejected\n");
    printf("✓ No cross-classification\n");
    printf("✓ Magic-based dispatch working correctly\n");

    return 0;
}
