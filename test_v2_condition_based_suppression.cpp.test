// V2 Condition-Based Suppression Test
// Tests coordinator behavior with broadcaster production beacon confirmation
// Verifies NO double production AND NO deadlock

#include <stdio.h>
#include <stdint.h>
#include <string.h>

// Mock timing constants from cluster_espnow_radio.cpp
constexpr uint32_t kSuppressionDelayMs = 10000U;  // V2: Grace period

struct CoordinatorState {
    bool grantedLeaseActive = false;
    uint32_t suppressionStartMs = 0;
    uint64_t leaseBroadcasterTag = 0;
    uint64_t leaseBroadcasterBoot = 0;
    uint32_t lastProductionBeaconFromLeasedBroadcasterMs = 0;
    uint32_t beaconsSuppressed = 0;
    uint32_t beaconsSent = 0;
};

// Simulate coordinator beacon decision logic
enum class BeaconDecision {
    SEND,           // Send beacon
    SUPPRESS        // Suppress (broadcaster active)
};

BeaconDecision coordinatorBeaconLogic(CoordinatorState& state, uint32_t now) {
    if (state.grantedLeaseActive && state.suppressionStartMs && now >= state.suppressionStartMs) {
        // Check if broadcaster is CONFIRMED active (recent production beacon within 2s)
        const bool broadcasterConfirmedActive = (state.lastProductionBeaconFromLeasedBroadcasterMs != 0 &&
                                                 (now - state.lastProductionBeaconFromLeasedBroadcasterMs) < 2000);

        if (broadcasterConfirmedActive) {
            // SAFE: Broadcaster confirmed sending production beacons, suppress coordinator
            state.beaconsSuppressed++;
            return BeaconDecision::SUPPRESS;
        } else {
            // SAFE: Broadcaster not confirmed - keep sending coordinator beacons
            state.beaconsSent++;
            return BeaconDecision::SEND;
        }
    }
    state.beaconsSent++;
    return BeaconDecision::SEND;
}

// Simulate broadcaster production beacon reception
void receiveProductionBeacon(CoordinatorState& state, uint32_t now,
                             uint64_t beaconTag, uint64_t beaconBoot) {
    if (state.grantedLeaseActive &&
        beaconTag == state.leaseBroadcasterTag &&
        beaconBoot == state.leaseBroadcasterBoot) {
        state.lastProductionBeaconFromLeasedBroadcasterMs = now;
    }
}

int main() {
    printf("=== V2 Condition-Based Suppression Test ===\n\n");

    bool allPass = true;

    // Test 1: Broadcaster not ready - Coordinator continues sending
    printf("Test 1 - Broadcaster NOT ready (no production beacons):\n");
    {
        CoordinatorState state;
        state.grantedLeaseActive = true;
        state.suppressionStartMs = 10000;  // Grace period ends at T=10000
        state.leaseBroadcasterTag = 0x1234567890ABCDEFULL;
        state.leaseBroadcasterBoot = 0xABCDEF01;

        // T=10000: Grace period ends, but NO production beacon received
        printf("  T=10000: Grace period ends, no broadcaster confirmation\n");
        auto decision = coordinatorBeaconLogic(state, 10000);
        bool test1a = (decision == BeaconDecision::SEND);
        printf("    Decision: %s (expected SEND)\n",
               decision == BeaconDecision::SEND ? "SEND" : "SUPPRESS");

        // T=15000: Still no broadcaster, coordinator continues
        printf("  T=15000: Still no broadcaster, coordinator continues\n");
        decision = coordinatorBeaconLogic(state, 15000);
        bool test1b = (decision == BeaconDecision::SEND);
        printf("    Decision: %s (expected SEND)\n",
               decision == BeaconDecision::SEND ? "SEND" : "SUPPRESS");

        // T=60000: Even after 50s, coordinator continues (NO DEADLOCK)
        printf("  T=60000: Long wait, coordinator still sending (NO DEADLOCK)\n");
        decision = coordinatorBeaconLogic(state, 60000);
        bool test1c = (decision == BeaconDecision::SEND);
        bool test1d = (state.beaconsSent == 3 && state.beaconsSuppressed == 0);
        printf("    Decision: %s (expected SEND)\n",
               decision == BeaconDecision::SEND ? "SEND" : "SUPPRESS");
        printf("    Beacons sent: %u, suppressed: %u (expected 3, 0)\n",
               state.beaconsSent, state.beaconsSuppressed);

        bool test1 = test1a && test1b && test1c && test1d;
        printf("  Result: %s\n\n", test1 ? "PASS ✓" : "FAIL ✗");
        allPass &= test1;
    }

    // Test 2: Broadcaster ready - Coordinator suppresses
    printf("Test 2 - Broadcaster READY (production beacons confirmed):\n");
    {
        CoordinatorState state;
        state.grantedLeaseActive = true;
        state.suppressionStartMs = 10000;
        state.leaseBroadcasterTag = 0x1234567890ABCDEFULL;
        state.leaseBroadcasterBoot = 0xABCDEF01;

        // T=0-10000: Grace period (beacons sent)
        printf("  T=5000: During grace period\n");
        auto decision = coordinatorBeaconLogic(state, 5000);
        bool test2a = (decision == BeaconDecision::SEND);
        printf("    Decision: %s (expected SEND)\n",
               decision == BeaconDecision::SEND ? "SEND" : "SUPPRESS");

        // T=11500: Broadcaster sends production beacon
        printf("  T=11500: Broadcaster sends production beacon\n");
        receiveProductionBeacon(state, 11500, 0x1234567890ABCDEFULL, 0xABCDEF01);
        printf("    Broadcaster confirmed at T=%u\n",
               state.lastProductionBeaconFromLeasedBroadcasterMs);

        // T=12000: Coordinator checks - broadcaster confirmed (within 2s)
        printf("  T=12000: Coordinator checks - broadcaster confirmed\n");
        decision = coordinatorBeaconLogic(state, 12000);
        bool test2b = (decision == BeaconDecision::SUPPRESS);
        printf("    Decision: %s (expected SUPPRESS)\n",
               decision == BeaconDecision::SEND ? "SEND" : "SUPPRESS");

        // T=13000: Still within 2s window - suppress
        printf("  T=13000: Still within confirmation window\n");
        decision = coordinatorBeaconLogic(state, 13000);
        bool test2c = (decision == BeaconDecision::SUPPRESS);
        printf("    Decision: %s (expected SUPPRESS)\n",
               decision == BeaconDecision::SEND ? "SEND" : "SUPPRESS");

        bool test2d = (state.beaconsSent == 1 && state.beaconsSuppressed == 2);
        printf("    Beacons sent: %u, suppressed: %u (expected 1, 2)\n",
               state.beaconsSent, state.beaconsSuppressed);

        bool test2 = test2a && test2b && test2c && test2d;
        printf("  Result: %s\n\n", test2 ? "PASS ✓" : "FAIL ✗");
        allPass &= test2;
    }

    // Test 3: Broadcaster loses time base - Coordinator resumes
    printf("Test 3 - Broadcaster LOSES time base (stops sending):\n");
    {
        CoordinatorState state;
        state.grantedLeaseActive = true;
        state.suppressionStartMs = 10000;
        state.leaseBroadcasterTag = 0x1234567890ABCDEFULL;
        state.leaseBroadcasterBoot = 0xABCDEF01;

        // T=11500: Broadcaster active
        receiveProductionBeacon(state, 11500, 0x1234567890ABCDEFULL, 0xABCDEF01);
        printf("  T=11500: Broadcaster confirmed active\n");

        // T=12000: Coordinator suppresses (broadcaster within 2s)
        auto decision = coordinatorBeaconLogic(state, 12000);
        bool test3a = (decision == BeaconDecision::SUPPRESS);
        printf("  T=12000: Coordinator suppresses\n");
        printf("    Decision: %s (expected SUPPRESS)\n",
               decision == BeaconDecision::SEND ? "SEND" : "SUPPRESS");

        // T=14000: 2.5s after last beacon - broadcaster STALE, coordinator RESUMES
        printf("  T=14000: Broadcaster stale (>2s), coordinator RESUMES\n");
        decision = coordinatorBeaconLogic(state, 14000);
        bool test3b = (decision == BeaconDecision::SEND);
        printf("    Decision: %s (expected SEND)\n",
               decision == BeaconDecision::SEND ? "SEND" : "SUPPRESS");
        printf("    Time since last broadcaster beacon: %u ms (>2000 threshold)\n",
               14000 - state.lastProductionBeaconFromLeasedBroadcasterMs);

        // T=20000: Coordinator continues (NO GAP in time service)
        printf("  T=20000: Coordinator continues (NO GAP)\n");
        decision = coordinatorBeaconLogic(state, 20000);
        bool test3c = (decision == BeaconDecision::SEND);
        printf("    Decision: %s (expected SEND)\n",
               decision == BeaconDecision::SEND ? "SEND" : "SUPPRESS");

        bool test3 = test3a && test3b && test3c;
        printf("  Result: %s\n\n", test3 ? "PASS ✓" : "FAIL ✗");
        allPass &= test3;
    }

    // Test 4: NO double production (suppress only when broadcaster confirmed)
    printf("Test 4 - NO double production:\n");
    {
        CoordinatorState state;
        state.grantedLeaseActive = true;
        state.suppressionStartMs = 10000;
        state.leaseBroadcasterTag = 0x1234567890ABCDEFULL;
        state.leaseBroadcasterBoot = 0xABCDEF01;

        bool doubleProduction = false;

        // Simulate 60s of operation
        for (uint32_t t = 0; t <= 60000; t += 100) {
            auto decision = coordinatorBeaconLogic(state, t);
            bool coordSending = (decision == BeaconDecision::SEND);

            // Broadcaster starts sending at T=12000
            bool broadcasterSending = false;
            if (t >= 12000 && t <= 50000) {
                // Simulate broadcaster sending production beacons every 100ms
                if (t % 100 == 0) {
                    receiveProductionBeacon(state, t, 0x1234567890ABCDEFULL, 0xABCDEF01);
                }
                broadcasterSending = true;
            }
            // Broadcaster stops at T=50000 (loses time base)

            // Check for double production (both sending simultaneously)
            if (coordSending && broadcasterSending) {
                // Allow brief overlap (up to 2s) during transition
                uint32_t timeSinceBroadcasterStart = t - 12000;
                if (timeSinceBroadcasterStart > 2000) {
                    doubleProduction = true;
                    printf("  ERROR: Double production at T=%u (coord=%s broadcaster=%s)\n",
                           t, coordSending ? "SEND" : "SUPPRESS",
                           broadcasterSending ? "ACTIVE" : "INACTIVE");
                    break;
                }
            }
        }

        bool test4 = !doubleProduction;
        printf("  Double production detected: %s (expected no)\n",
               doubleProduction ? "yes" : "no");
        printf("  Result: %s\n\n", test4 ? "PASS ✓" : "FAIL ✗");
        allPass &= test4;
    }

    // Test 5: Wrong broadcaster tag - ignored
    printf("Test 5 - Wrong broadcaster identity (ignored):\n");
    {
        CoordinatorState state;
        state.grantedLeaseActive = true;
        state.suppressionStartMs = 10000;
        state.leaseBroadcasterTag = 0x1234567890ABCDEFULL;
        state.leaseBroadcasterBoot = 0xABCDEF01;

        // T=12000: Receive beacon from DIFFERENT broadcaster (wrong tag)
        printf("  T=12000: Production beacon from DIFFERENT broadcaster\n");
        receiveProductionBeacon(state, 12000, 0xFFFFFFFFFFFFFFFFULL, 0xABCDEF01);
        printf("    lastProductionBeacon: %u (expected 0 - ignored)\n",
               state.lastProductionBeaconFromLeasedBroadcasterMs);

        // T=13000: Coordinator should NOT suppress (wrong broadcaster)
        auto decision = coordinatorBeaconLogic(state, 13000);
        bool test5a = (decision == BeaconDecision::SEND);
        bool test5b = (state.lastProductionBeaconFromLeasedBroadcasterMs == 0);
        printf("  T=13000: Coordinator decision\n");
        printf("    Decision: %s (expected SEND - wrong broadcaster)\n",
               decision == BeaconDecision::SEND ? "SEND" : "SUPPRESS");

        bool test5 = test5a && test5b;
        printf("  Result: %s\n\n", test5 ? "PASS ✓" : "FAIL ✗");
        allPass &= test5;
    }

    // Test 6: Grace period allows bootstrap
    printf("Test 6 - Grace period (10s):\n");
    {
        CoordinatorState state;
        state.grantedLeaseActive = true;
        state.suppressionStartMs = 10000;

        printf("  Grace period: %u ms\n", kSuppressionDelayMs);
        printf("  Allows multiple 16-sample series attempts (~2-4s each)\n");

        bool test6 = (kSuppressionDelayMs >= 10000);
        printf("  Grace >= 10s: %s\n", test6 ? "yes ✓" : "no ✗");
        printf("  Result: %s\n\n", test6 ? "PASS ✓" : "FAIL ✗");
        allPass &= test6;
    }

    // Final verdict
    printf("=== Final Verdict ===\n");
    if (allPass) {
        printf("✓ ALL TESTS PASSED\n");
        printf("✓ NO double production (coordinator suppresses only when broadcaster confirmed)\n");
        printf("✓ NO deadlock (coordinator continues if broadcaster not ready)\n");
        printf("✓ NO timer-based trust (uses authenticated production beacons)\n");
        printf("✓ Automatic recovery (coordinator resumes if broadcaster stops)\n");
        printf("✓ Security preserved (wrong broadcaster identity ignored)\n");
        printf("✓ V2 condition-based suppression verified\n");
        return 0;
    } else {
        printf("✗ SOME TESTS FAILED\n");
        printf("V2 condition-based suppression has issues!\n");
        return 1;
    }
}
