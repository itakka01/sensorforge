// Beta131 - Lease State Machine Offline Test
// Test lease timing logic WITHOUT hardware dependencies

#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include <assert.h>

// Simulated state (extracted from cluster_espnow_radio.cpp logic)
struct CoordinatorState {
    bool grantedLeaseActive = false;
    uint32_t grantedLeaseExpiresMs = 0;
    uint32_t grantNextMs = 0;
    uint32_t pendingTransaction = 0;
    uint32_t pendingAt = 0;
    // Beta131-FIX (Eighth cycle, Problem 1): Startup guard
    uint32_t startupGuardUntilMs = 0;
    // Beta131-FIX (Tenth cycle, CORRECTED): Delayed suppression
    uint32_t suppressionStartMs = 0;
    bool beaconsSuppressed(uint32_t now) const {
        // Beta131-FIX (Tenth cycle): Suppress only after suppression delay expires
        if(startupGuardUntilMs > 0 && now < startupGuardUntilMs) return true;  // Startup guard
        if(grantedLeaseActive && suppressionStartMs > 0 && now >= suppressionStartMs) return true;  // Delayed suppression
        return false;
    }
};

struct BroadcasterState {
    bool leaseActive = false;
    uint32_t leaseActivationMs = 0;
    uint32_t leaseExpiresMs = 0;
    uint32_t activationTransaction = 0;
    bool timeBaseValid = true;  // Simplified: always valid
    bool sendingBeacons() const { return leaseActive; }
};

// Test parameters
constexpr uint32_t GRANT_INTERVAL_MS = 2000;
constexpr uint32_t LEASE_DURATION_MS = 3000;
constexpr uint32_t SAFETY_MARGIN_MS = 1000;
constexpr uint32_t GUARD_TIME_MS = 500;  // OLD: broadcaster activation delay
constexpr uint32_t PENDING_TIMEOUT_MS = 2000;
constexpr uint32_t RF_DELAY_MIN_MS = 1;
constexpr uint32_t RF_DELAY_MAX_MS = 50;
// Beta131-FIX (Eighth cycle, Problem 1): Startup guard duration
constexpr uint32_t STARTUP_GUARD_MS = 6000;
// Beta131-FIX (Tenth cycle, CORRECTED): Bootstrap timing coordination
constexpr uint32_t COORDINATOR_SUPPRESSION_DELAY_MS = 1000;  // Coordinator suppresses 1000ms after Grant send
constexpr uint32_t BROADCASTER_ACTIVATION_DELAY_MS = 1500;   // Broadcaster activates 1500ms after Grant receive

// Simulated actions
void coordinatorSendGrant(CoordinatorState &c, uint32_t now, uint32_t transaction, uint32_t rfDelay) {
    const bool isRenewal = c.grantedLeaseActive;
    const uint32_t newExpiryMs = now + LEASE_DURATION_MS + SAFETY_MARGIN_MS;
    const uint32_t remainingMs = isRenewal && now < c.grantedLeaseExpiresMs ?
                                  c.grantedLeaseExpiresMs - now : 0;

    // Beta131-FIX (Tenth cycle, CORRECTED): Schedule suppression on Grant send
    if(isRenewal) {
        if(remainingMs <= 2000) {
            c.grantedLeaseExpiresMs = newExpiryMs;
        }
    } else {
        // Initial grant: activate lease and schedule suppression
        c.grantedLeaseActive = true;
        c.grantedLeaseExpiresMs = newExpiryMs;
        c.suppressionStartMs = now + COORDINATOR_SUPPRESSION_DELAY_MS;
    }
    c.grantNextMs = now + GRANT_INTERVAL_MS;
    c.pendingTransaction = transaction;
    c.pendingAt = now;
}

void broadcasterReceiveGrant(BroadcasterState &b, uint32_t now, uint32_t transaction) {
    const bool isRenewal = b.leaseActive;

    if(isRenewal) {
        b.leaseExpiresMs = now + LEASE_DURATION_MS;
    } else {
        // Beta131-FIX (Tenth cycle, CORRECTED): Use new activation delay
        b.leaseActivationMs = now + BROADCASTER_ACTIVATION_DELAY_MS;
        b.leaseExpiresMs = now + LEASE_DURATION_MS;
        b.activationTransaction = transaction;
    }
}

void coordinatorReceiveAck(CoordinatorState &c, uint32_t now) {
    c.pendingTransaction = 0;
}

void broadcasterTickActivation(BroadcasterState &b, uint32_t now) {
    if(!b.leaseActive && b.leaseActivationMs && now >= b.leaseActivationMs && b.timeBaseValid) {
        b.leaseActive = true;
    }
}

void broadcasterTickExpiry(BroadcasterState &b, uint32_t now) {
    if(b.leaseActive && now >= b.leaseExpiresMs) {
        b.leaseActive = false;
        b.leaseActivationMs = 0;
        b.activationTransaction = 0;
    }
}

void coordinatorTickExpiry(CoordinatorState &c, uint32_t now) {
    if(c.grantedLeaseActive && now >= c.grantedLeaseExpiresMs) {
        c.grantedLeaseActive = false;
    }
    // Beta131-FIX (Eighth cycle, Problem 1): Clear startup guard when expired
    if(c.startupGuardUntilMs && now >= c.startupGuardUntilMs) {
        c.startupGuardUntilMs = 0;
    }
}

void coordinatorTickTimeout(CoordinatorState &c, uint32_t now) {
    if(c.pendingTransaction && (now - c.pendingAt) > PENDING_TIMEOUT_MS) {
        c.pendingTransaction = 0;
    }
}

// Validate sender exclusivity
bool validateExclusivity(const CoordinatorState &c, const BroadcasterState &b, uint32_t now) {
    const bool coordSending = !c.beaconsSuppressed(now);
    const bool broadSending = b.sendingBeacons();

    if(coordSending && broadSending) {
        printf("FAIL @ T=%u: BOTH SENDING! Coord=%d Broad=%d\n",
               now, coordSending, broadSending);
        return false;
    }
    return true;
}

// Test scenarios
bool testNormalHandover() {
    printf("\n=== TEST 1: Normal Handover ===\n");
    CoordinatorState c;
    BroadcasterState b;
    uint32_t transaction = 1;
    const uint32_t rfDelay = 5;  // 5ms RF delay

    // T=0: Initial state - coordinator sends beacons
    uint32_t now = 0;
    assert(!c.beaconsSuppressed(now));
    assert(!b.sendingBeacons());
    printf("T=%u: Coord=YES, Broad=NO ✓\n", now);

    // T=0: Coordinator sends Grant
    coordinatorSendGrant(c, now, transaction, rfDelay);
    // Beta131-FIX (Tenth cycle): Coordinator does NOT suppress immediately
    assert(!c.beaconsSuppressed(now));  // NOT suppressed yet (bootstrap grace period)
    assert(c.suppressionStartMs == COORDINATOR_SUPPRESSION_DELAY_MS);
    assert(c.grantedLeaseExpiresMs == LEASE_DURATION_MS + SAFETY_MARGIN_MS);
    printf("T=%u: Grant sent, suppression at T=%u\n", now, c.suppressionStartMs);

    // T=5: Broadcaster receives Grant
    now = rfDelay;
    broadcasterReceiveGrant(b, now, transaction);
    assert(b.leaseActivationMs == now + BROADCASTER_ACTIVATION_DELAY_MS);
    assert(b.leaseExpiresMs == now + LEASE_DURATION_MS);
    printf("T=%u: Grant received, activation at T=%u, expiry at T=%u\n",
           now, b.leaseActivationMs, b.leaseExpiresMs);

    // T=10: Coordinator receives Ack
    now = 10;
    coordinatorReceiveAck(c, now);
    assert(c.pendingTransaction == 0);

    // T=1000: Coordinator suppression activates
    now = COORDINATOR_SUPPRESSION_DELAY_MS;
    assert(c.beaconsSuppressed(now));  // NOW suppressed
    assert(!b.sendingBeacons());       // Broadcaster not active yet
    if(!validateExclusivity(c, b, now)) return false;
    printf("T=%u: Coord=NO (suppressed), Broad=NO (not active yet) ✓\n", now);

    // T=1505: Broadcaster activates
    now = rfDelay + BROADCASTER_ACTIVATION_DELAY_MS;
    broadcasterTickActivation(b, now);
    assert(b.sendingBeacons());
    assert(c.beaconsSuppressed(now));
    if(!validateExclusivity(c, b, now)) return false;
    printf("T=%u: Coord=NO, Broad=YES ✓\n", now);

    // T=3005: Broadcaster lease expires
    now = rfDelay + LEASE_DURATION_MS;
    broadcasterTickExpiry(b, now);
    assert(!b.sendingBeacons());
    assert(c.beaconsSuppressed(now));  // Still suppressed!
    if(!validateExclusivity(c, b, now)) return false;
    printf("T=%u: Coord=NO, Broad=NO (GAP) ✓\n", now);

    // T=4000: Coordinator lease expires, resumes
    now = LEASE_DURATION_MS + SAFETY_MARGIN_MS;
    coordinatorTickExpiry(c, now);
    assert(!c.beaconsSuppressed(now));
    assert(!b.sendingBeacons());
    if(!validateExclusivity(c, b, now)) return false;
    printf("T=%u: Coord=YES, Broad=NO (RESUMED) ✓\n", now);

    printf("PASS: Handover with ~%ums gap\n",
           (SAFETY_MARGIN_MS - rfDelay - BROADCASTER_ACTIVATION_DELAY_MS));
    return true;
}

bool testRenewal() {
    printf("\n=== TEST 2: Seamless Renewal ===\n");
    CoordinatorState c;
    BroadcasterState b;
    uint32_t transaction = 1;
    const uint32_t rfDelay = 5;

    // Setup: Broadcaster already active at T=1505
    uint32_t now = 0;
    coordinatorSendGrant(c, now, transaction, rfDelay);
    now = rfDelay;
    broadcasterReceiveGrant(b, now, transaction);
    now = rfDelay + BROADCASTER_ACTIVATION_DELAY_MS;
    broadcasterTickActivation(b, now);
    assert(b.sendingBeacons());
    printf("T=%u: Initial lease active\n", now);

    // T=2000: Coordinator sends renewal
    now = 2000;
    ++transaction;
    coordinatorSendGrant(c, now, transaction, rfDelay);
    printf("T=%u: Renewal sent, suppression extended to T=%u\n",
           now, c.grantedLeaseExpiresMs);

    // T=2005: Broadcaster receives renewal
    now = 2005;
    broadcasterReceiveGrant(b, now, transaction);
    assert(b.sendingBeacons());  // Still active!
    assert(b.leaseExpiresMs == now + LEASE_DURATION_MS);
    printf("T=%u: Renewal received, lease extended to T=%u\n",
           now, b.leaseExpiresMs);

    // Verify no interruption
    for(uint32_t t = rfDelay + BROADCASTER_ACTIVATION_DELAY_MS; t <= 5005; t += 100) {
        now = t;
        broadcasterTickExpiry(b, now);
        coordinatorTickExpiry(c, now);
        if(t < b.leaseExpiresMs) {
            assert(b.sendingBeacons());
            assert(c.beaconsSuppressed(now));
        }
        if(!validateExclusivity(c, b, now)) return false;
    }

    printf("PASS: Seamless renewal without interruption\n");
    return true;
}

bool testLostGrant() {
    printf("\n=== TEST 3: Lost Grant (Fallback) ===\n");
    CoordinatorState c;
    BroadcasterState b;
    uint32_t transaction = 1;
    const uint32_t rfDelay = 5;

    // Setup: Broadcaster active
    uint32_t now = 0;
    coordinatorSendGrant(c, now, transaction, rfDelay);
    now = rfDelay;
    broadcasterReceiveGrant(b, now, transaction);
    now = rfDelay + BROADCASTER_ACTIVATION_DELAY_MS;
    broadcasterTickActivation(b, now);
    printf("T=%u: Broadcaster active until T=%u\n", now, b.leaseExpiresMs);

    // T=2000: Coordinator sends renewal, but IT GETS LOST
    now = 2000;
    ++transaction;
    coordinatorSendGrant(c, now, transaction, rfDelay);
    printf("T=%u: Renewal sent (will be LOST)\n", now);
    // Broadcaster NEVER receives it!

    // T=3005: Broadcaster expires
    now = rfDelay + LEASE_DURATION_MS;
    broadcasterTickExpiry(b, now);
    assert(!b.sendingBeacons());
    assert(c.beaconsSuppressed(now));  // Coordinator still suppressed!
    if(!validateExclusivity(c, b, now)) return false;
    printf("T=%u: Broadcaster stopped, Coordinator still suppressed (GAP)\n", now);

    // T=6000: Coordinator expires
    now = 2000 + LEASE_DURATION_MS + SAFETY_MARGIN_MS;
    coordinatorTickExpiry(c, now);
    assert(!c.beaconsSuppressed(now));
    if(!validateExclusivity(c, b, now)) return false;
    printf("T=%u: Coordinator resumed after safety margin\n", now);

    const uint32_t gapMs = now - (rfDelay + LEASE_DURATION_MS);
    printf("PASS: Lost grant caused %ums gap (safe fallback)\n", gapMs);
    return true;
}

bool testLostAck() {
    printf("\n=== TEST 4: Lost Ack (Timeout) ===\n");
    CoordinatorState c;
    BroadcasterState b;
    uint32_t transaction = 1;
    const uint32_t rfDelay = 5;

    // T=0: Coordinator sends Grant
    uint32_t now = 0;
    coordinatorSendGrant(c, now, transaction, rfDelay);
    assert(c.pendingTransaction == transaction);

    // T=5: Broadcaster receives, sends Ack, but ACK GETS LOST
    now = rfDelay;
    broadcasterReceiveGrant(b, now, transaction);
    // Coordinator NEVER receives Ack!

    // T=505: Broadcaster activates
    now = rfDelay + BROADCASTER_ACTIVATION_DELAY_MS;
    broadcasterTickActivation(b, now);
    assert(b.sendingBeacons());
    assert(c.pendingTransaction == transaction);  // Still pending!
    printf("T=%u: Broadcaster active, Ack pending\n", now);

    // T=2005: Timeout clears pending
    now = PENDING_TIMEOUT_MS + rfDelay;
    coordinatorTickTimeout(c, now);
    assert(c.pendingTransaction == 0);  // Cleared!
    printf("T=%u: Pending timeout cleared\n", now);

    // Broadcaster continues normally
    now = rfDelay + LEASE_DURATION_MS;
    broadcasterTickExpiry(b, now);
    assert(!b.sendingBeacons());
    printf("T=%u: Broadcaster expired normally\n", now);

    printf("PASS: Lost Ack handled with timeout\n");
    return true;
}

bool testSourceSwitch() {
    printf("\n=== TEST 5: Coordinator → Broadcaster → Coordinator ===\n");
    CoordinatorState c;
    BroadcasterState b;
    uint32_t transaction = 1;
    const uint32_t rfDelay = 5;

    // Phase 1: Coordinator active
    uint32_t now = 0;
    assert(!c.beaconsSuppressed(now));
    printf("T=%u: Coordinator active\n", now);

    // Phase 2: Switch to Broadcaster
    coordinatorSendGrant(c, now, transaction, rfDelay);
    now = rfDelay;
    broadcasterReceiveGrant(b, now, transaction);
    now = rfDelay + BROADCASTER_ACTIVATION_DELAY_MS;
    broadcasterTickActivation(b, now);
    assert(b.sendingBeacons());
    assert(c.beaconsSuppressed(now));
    if(!validateExclusivity(c, b, now)) return false;
    printf("T=%u: Switched to Broadcaster\n", now);

    // Phase 3: Broadcaster expires, back to Coordinator
    now = LEASE_DURATION_MS + SAFETY_MARGIN_MS;
    broadcasterTickExpiry(b, now);
    coordinatorTickExpiry(c, now);
    assert(!b.sendingBeacons());
    assert(!c.beaconsSuppressed(now));
    if(!validateExclusivity(c, b, now)) return false;
    printf("T=%u: Switched back to Coordinator\n", now);

    printf("PASS: Source switching without overlap\n");
    return true;
}

bool testDelayedRenewal() {
    printf("\n=== TEST 6: Delayed Renewal (Variable RF Delay) ===\n");
    CoordinatorState c;
    BroadcasterState b;
    uint32_t transaction = 1;

    // Initial Grant with 5ms RF delay
    uint32_t now = 0;
    const uint32_t rfDelay1 = 5;
    coordinatorSendGrant(c, now, transaction, rfDelay1);
    now = rfDelay1;
    broadcasterReceiveGrant(b, now, transaction);
    now = rfDelay1 + BROADCASTER_ACTIVATION_DELAY_MS;
    broadcasterTickActivation(b, now);
    assert(b.sendingBeacons());
    printf("T=%u: Initial lease active\n", now);

    // T=2000: Renewal sent with 45ms RF delay (max)
    now = 2000;
    ++transaction;
    const uint32_t rfDelay2 = 45;  // Maximum RF delay
    coordinatorSendGrant(c, now, transaction, rfDelay2);
    assert(c.grantedLeaseExpiresMs == now + LEASE_DURATION_MS + SAFETY_MARGIN_MS);
    printf("T=%u: Renewal sent (45ms RF delay)\n", now);

    // T=2045: Broadcaster receives renewal (delayed)
    now = 2045;
    broadcasterReceiveGrant(b, now, transaction);
    assert(b.sendingBeacons());  // Still active
    assert(b.leaseExpiresMs == now + LEASE_DURATION_MS);
    printf("T=%u: Delayed renewal received, lease extended to T=%u\n", now, b.leaseExpiresMs);

    // Verify continuous operation
    for(uint32_t t = 2045; t <= 5045; t += 100) {
        broadcasterTickExpiry(b, t);
        coordinatorTickExpiry(c, t);
        if(t < b.leaseExpiresMs) {
            assert(b.sendingBeacons());
            assert(c.beaconsSuppressed(now));
        }
        if(!validateExclusivity(c, b, t)) return false;
    }

    printf("PASS: Delayed renewal handled correctly\n");
    return true;
}

bool testCoordinatorReboot() {
    printf("\n=== TEST 7: Coordinator Reboot During Lease (STARTUP GUARD) ===\n");
    CoordinatorState c;
    BroadcasterState b;
    uint32_t transaction = 1;
    const uint32_t rfDelay = 5;

    // Setup: Broadcaster active
    uint32_t now = 0;
    coordinatorSendGrant(c, now, transaction, rfDelay);
    now = rfDelay;
    broadcasterReceiveGrant(b, now, transaction);
    now = rfDelay + BROADCASTER_ACTIVATION_DELAY_MS;
    broadcasterTickActivation(b, now);
    assert(b.sendingBeacons());
    printf("T=%u: Broadcaster active until T=%u\n", now, b.leaseExpiresMs);

    // T=1500: Coordinator reboots (loses state)
    now = 1500;
    printf("T=%u: Coordinator REBOOTS (loses lease state)\n", now);
    c = CoordinatorState();  // Reset all state
    assert(!c.grantedLeaseActive);  // Lost knowledge of lease

    // Beta131-FIX (Eighth cycle, Problem 1): Set startup guard
    // CRITICAL: Prevents overlap after reboot
    c.startupGuardUntilMs = now + STARTUP_GUARD_MS;
    printf("T=%u: Startup guard set until T=%u\n", now, c.startupGuardUntilMs);

    // Verify beacons suppressed by startup guard
    assert(c.beaconsSuppressed(now));  // Guard active!
    assert(b.sendingBeacons());     // Broadcaster still active
    if(!validateExclusivity(c, b, now)) {
        printf("FAIL: Overlap detected after reboot!\n");
        return false;
    }
    printf("T=%u: Coord=NO (guard), Broad=YES ✓\n", now);

    // T=3005: Broadcaster lease expires
    now = rfDelay + LEASE_DURATION_MS;
    broadcasterTickExpiry(b, now);
    coordinatorTickExpiry(c, now);
    assert(!b.sendingBeacons());       // Broadcaster stopped
    assert(c.beaconsSuppressed(now));     // Guard still active!
    if(!validateExclusivity(c, b, now)) {
        printf("FAIL: Overlap detected during guard!\n");
        return false;
    }
    printf("T=%u: Coord=NO (guard), Broad=NO ✓\n", now);

    // T=7500: Startup guard expires
    now = 1500 + STARTUP_GUARD_MS;
    coordinatorTickExpiry(c, now);
    assert(!c.beaconsSuppressed(now));    // Guard expired, resumed!
    assert(!b.sendingBeacons());       // Broadcaster still stopped
    if(!validateExclusivity(c, b, now)) {
        printf("FAIL: Overlap detected after guard expiry!\n");
        return false;
    }
    printf("T=%u: Coord=YES (guard expired), Broad=NO ✓\n", now);

    printf("PASS: Startup guard prevents overlap after coordinator reboot\n");
    return true;
}

bool testMultipleLostRenewals() {
    printf("\n=== TEST 8: Multiple Lost Renewals ===\n");
    CoordinatorState c;
    BroadcasterState b;
    uint32_t transaction = 1;
    const uint32_t rfDelay = 5;

    // Initial Grant
    uint32_t now = 0;
    coordinatorSendGrant(c, now, transaction, rfDelay);
    now = rfDelay;
    broadcasterReceiveGrant(b, now, transaction);
    now = rfDelay + BROADCASTER_ACTIVATION_DELAY_MS;
    broadcasterTickActivation(b, now);
    printf("T=%u: Broadcaster active\n", now);

    // T=2000: First renewal - LOST
    now = 2000;
    ++transaction;
    coordinatorSendGrant(c, now, transaction, rfDelay);
    printf("T=%u: Renewal 1 sent (LOST)\n", now);
    // Broadcaster never receives it

    // T=4000: Second renewal - LOST
    now = 4000;
    ++transaction;
    coordinatorSendGrant(c, now, transaction, rfDelay);
    printf("T=%u: Renewal 2 sent (LOST)\n", now);
    // Broadcaster never receives it

    // T=3005: Original broadcaster lease expires
    now = rfDelay + LEASE_DURATION_MS;
    broadcasterTickExpiry(b, now);
    assert(!b.sendingBeacons());
    printf("T=%u: Broadcaster expired\n", now);

    // Coordinator still suppressed due to lost renewals
    assert(c.beaconsSuppressed(now));
    if(!validateExclusivity(c, b, now)) return false;

    // T=8000: Coordinator suppression from second renewal expires
    now = 4000 + LEASE_DURATION_MS + SAFETY_MARGIN_MS;
    coordinatorTickExpiry(c, now);
    assert(!c.beaconsSuppressed(now));
    printf("T=%u: Coordinator resumed\n", now);

    uint32_t gapMs = now - (rfDelay + LEASE_DURATION_MS);
    printf("PASS: Multiple lost renewals → %ums gap (safe fallback)\n", gapMs);
    return true;
}

bool testRebootDuringRenewal() {
    printf("\n=== TEST 9: Coordinator Reboot During Renewal ===\n");
    CoordinatorState c;
    BroadcasterState b;
    uint32_t transaction = 1;
    const uint32_t rfDelay = 5;

    // Setup: Broadcaster active with initial lease
    uint32_t now = 0;
    coordinatorSendGrant(c, now, transaction, rfDelay);
    now = rfDelay;
    broadcasterReceiveGrant(b, now, transaction);
    now = rfDelay + BROADCASTER_ACTIVATION_DELAY_MS;
    broadcasterTickActivation(b, now);
    printf("T=%u: Broadcaster active\n", now);

    // T=2000: Coordinator sends renewal
    now = 2000;
    ++transaction;
    coordinatorSendGrant(c, now, transaction, rfDelay);
    printf("T=%u: Renewal sent\n", now);

    // T=2005: Broadcaster receives renewal
    now = 2005;
    broadcasterReceiveGrant(b, now, transaction);
    assert(b.leaseExpiresMs == now + LEASE_DURATION_MS);  // Extended to 5005
    printf("T=%u: Renewal received, lease extended to T=%u\n", now, b.leaseExpiresMs);

    // T=3000: Coordinator reboots during active renewed lease
    now = 3000;
    printf("T=%u: Coordinator REBOOTS during renewal\n", now);
    c = CoordinatorState();
    c.startupGuardUntilMs = now + STARTUP_GUARD_MS;  // Guard until 9000
    printf("T=%u: Startup guard set until T=%u\n", now, c.startupGuardUntilMs);

    // Verify no overlap during remaining broadcaster lease
    assert(c.beaconsSuppressed(now));  // Guard active
    assert(b.sendingBeacons());     // Still active
    if(!validateExclusivity(c, b, now)) {
        printf("FAIL: Overlap after reboot during renewal!\n");
        return false;
    }
    printf("T=%u: Coord=NO (guard), Broad=YES ✓\n", now);

    // T=5005: Broadcaster lease expires
    now = 2005 + LEASE_DURATION_MS;
    broadcasterTickExpiry(b, now);
    assert(!b.sendingBeacons());
    assert(c.beaconsSuppressed(now));  // Guard still active until 9000
    if(!validateExclusivity(c, b, now)) {
        printf("FAIL: Overlap during guard!\n");
        return false;
    }
    printf("T=%u: Coord=NO (guard), Broad=NO ✓\n", now);

    // T=9000: Startup guard expires
    now = 3000 + STARTUP_GUARD_MS;
    coordinatorTickExpiry(c, now);
    assert(!c.beaconsSuppressed(now));
    if(!validateExclusivity(c, b, now)) {
        printf("FAIL: Overlap after guard expiry!\n");
        return false;
    }
    printf("T=%u: Coord=YES (guard expired), Broad=NO ✓\n", now);

    printf("PASS: Startup guard prevents overlap after reboot during renewal\n");
    return true;
}

bool testCaptureSourceSwitch() {
    printf("\n=== TEST 10: Capture Source Switch Detection ===\n");

    // Simulate capture scheduling and source tracking
    struct CaptureState {
        bool active = false;
        uint32_t epoch = 0;
        uint32_t sourceGeneration = 0;
    };

    uint32_t currentEpoch = 100;
    uint32_t sourceGeneration = 5;  // Coordinator active
    CaptureState capture;

    // T=0: Accept capture with current source (Coordinator)
    capture.active = true;
    capture.epoch = currentEpoch;
    capture.sourceGeneration = sourceGeneration;
    printf("T=0: Capture accepted (epoch=%u, generation=%u)\n",
           capture.epoch, capture.sourceGeneration);

    // T=1000: Switch to Broadcaster (same epoch, different generation)
    uint32_t now = 1000;
    sourceGeneration = 6;  // Source changed!
    printf("T=%u: Source switched to Broadcaster (epoch=%u, generation=%u)\n",
           now, currentEpoch, sourceGeneration);

    // Validate capture before execution
    if(capture.epoch != currentEpoch) {
        printf("T=%u: Capture would be ABORTED - epoch changed\n", now);
    } else if(capture.sourceGeneration != sourceGeneration) {
        printf("T=%u: Capture ABORTED - source generation changed (%u -> %u) ✓\n",
               now, capture.sourceGeneration, sourceGeneration);
        capture.active = false;
    }

    assert(!capture.active);  // Must be aborted!

    // Test 2: Epoch change also triggers abort
    capture.active = true;
    capture.epoch = currentEpoch;
    capture.sourceGeneration = sourceGeneration;
    printf("\nT=%u: New capture accepted (epoch=%u, generation=%u)\n",
           now, capture.epoch, capture.sourceGeneration);

    // T=2000: Epoch changes
    now = 2000;
    currentEpoch = 101;
    sourceGeneration = 7;
    printf("T=%u: Epoch changed (epoch=%u, generation=%u)\n",
           now, currentEpoch, sourceGeneration);

    if(capture.epoch != currentEpoch) {
        printf("T=%u: Capture ABORTED - epoch changed (%u -> %u) ✓\n",
               now, capture.epoch, currentEpoch);
        capture.active = false;
    }

    assert(!capture.active);  // Must be aborted!

    printf("PASS: Capture source switch detection works correctly\n");
    return true;
}

bool testCaptureRadioRestart() {
    printf("\n=== TEST 11: Capture Invalidation on Radio Restart ===\n");

    // Simulate capture scheduling and radio restart
    struct CaptureState {
        bool active = false;
        uint32_t epoch = 0;
        uint32_t sourceGeneration = 0;
    };

    struct RadioState {
        bool running = false;
        uint32_t sourceGeneration = 0;
    };

    uint32_t currentEpoch = 100;
    RadioState radio;
    CaptureState capture;

    // T=0: Radio starts, source generation = 0
    radio.running = true;
    radio.sourceGeneration = 0;
    printf("T=0: Radio started (generation=%u)\n", radio.sourceGeneration);

    // T=1000: Source change
    radio.sourceGeneration++;
    printf("T=1000: Source changed (generation=%u)\n", radio.sourceGeneration);

    // T=2000: Capture accepted
    capture.active = true;
    capture.epoch = currentEpoch;
    capture.sourceGeneration = radio.sourceGeneration;
    printf("T=2000: Capture accepted (epoch=%u, generation=%u)\n",
           capture.epoch, capture.sourceGeneration);

    // T=3000: Radio STOPS
    // Beta131-FIX (Ninth cycle, Problem 2): sourceGeneration increments on stop
    radio.sourceGeneration++;  // Monotonic increment, NOT reset to 0
    radio.running = false;
    printf("T=3000: Radio STOPPED (generation incremented to %u)\n",
           radio.sourceGeneration);

    // T=4000: Radio STARTS again
    radio.running = true;
    // sourceGeneration stays at incremented value (monotonic!)
    printf("T=4000: Radio STARTED (generation=%u, monotonic)\n",
           radio.sourceGeneration);

    // T=5000: Capture validation before execution
    if(capture.epoch != currentEpoch) {
        printf("T=5000: Capture would be ABORTED - epoch changed\n");
        capture.active = false;
    } else if(capture.sourceGeneration != radio.sourceGeneration) {
        printf("T=5000: Capture ABORTED - generation changed after radio restart (%u -> %u) ✓\n",
               capture.sourceGeneration, radio.sourceGeneration);
        capture.active = false;
    } else {
        printf("T=5000: ERROR - Capture should have been aborted!\n");
        return false;
    }

    assert(!capture.active);  // Must be aborted!

    // Test 2: Verify monotonic behavior prevents collision
    printf("\nVerifying monotonic property prevents generation collision:\n");

    // Scenario that would fail with reset-to-zero:
    // Gen=0 → Gen=1 → Capture(gen=1) → Stop(reset to 0) → Start(gen=0) → Change(gen=1) → Execute(1==1) WRONG!

    // With monotonic increment:
    // Gen=0 → Gen=1 → Capture(gen=1) → Stop(gen→2) → Start(gen=2) → Change(gen=3) → Execute(1≠3) CORRECT!

    uint32_t gen = 0;
    printf("Initial: gen=%u\n", gen);

    gen++;  // Source change
    printf("Source change: gen=%u\n", gen);

    uint32_t capturedGen = gen;
    printf("Capture accepted: capturedGen=%u\n", capturedGen);

    gen++;  // Stop (monotonic increment)
    printf("Radio stop (monotonic increment): gen=%u\n", gen);

    // Start - gen stays same (no reset!)
    printf("Radio start (no reset): gen=%u\n", gen);

    gen++;  // Another source change
    printf("Source change: gen=%u\n", gen);

    if(capturedGen != gen) {
        printf("Validation: %u != %u → ABORT ✓ Monotonic property prevents collision\n",
               capturedGen, gen);
    } else {
        printf("ERROR: Generations match %u == %u → WOULD EXECUTE WRONG!\n",
               capturedGen, gen);
        return false;
    }

    printf("PASS: Radio restart invalidates pending captures via monotonic generation\n");
    return true;
}

// Test 12: Bootstrap Timing - Coordinator suppresses BEFORE Broadcaster activates
bool testBootstrapTiming() {
    printf("\n--- TEST 12: Bootstrap Timing (No Overlap) ---\n");

    CoordinatorState c;
    BroadcasterState b;
    uint32_t now = 0;
    uint32_t rfDelay = RF_DELAY_MAX_MS;  // Worst-case RF delay

    printf("T=%u: Initial state - coordinator startup guard EXPIRED, both idle\n", now);
    assert(!c.beaconsSuppressed(now));
    assert(!b.sendingBeacons());

    // Coordinator sends initial grant
    now = 1000;
    printf("T=%u: Coordinator sends INITIAL Grant\n", now);
    coordinatorSendGrant(c, now, 1, rfDelay);
    printf("  Coordinator: suppressionStartMs=%u (suppresses at T=%u)\n",
           c.suppressionStartMs, c.suppressionStartMs);
    printf("  Coordinator: beacons NOT suppressed yet (bootstrap grace period)\n");
    assert(!c.beaconsSuppressed(now));  // Should NOT suppress yet

    // Broadcaster receives grant (with RF delay)
    now += rfDelay;  // T=1050
    printf("T=%u: Broadcaster receives Grant (RF delay=%ums)\n", now, rfDelay);
    broadcasterReceiveGrant(b, now, 1);
    printf("  Broadcaster: leaseActivationMs=%u (activates at T=%u)\n",
           b.leaseActivationMs, b.leaseActivationMs);
    assert(!b.sendingBeacons());  // Should NOT send yet

    // Broadcaster sends Ack
    printf("T=%u: Broadcaster sends Ack\n", now);

    // Coordinator receives Ack (with RF delay)
    now += rfDelay;  // T=1100
    printf("T=%u: Coordinator receives Ack (RF delay=%ums)\n", now, rfDelay);
    coordinatorReceiveAck(c, now);

    // Bootstrap period: Coordinator keeps sending beacons for broadcaster to sync
    printf("\n--- Bootstrap Period: Coordinator sends beacons, Broadcaster builds time base ---\n");

    // Check timing at various points
    now = 1500;
    printf("T=%u: Coordinator still sending (suppression at T=%u)\n", now, c.suppressionStartMs);
    assert(!c.beaconsSuppressed(now));  // Coordinator NOT suppressed yet
    assert(!b.sendingBeacons());        // Broadcaster NOT sending yet
    printf("  Status: Coordinator SENDING, Broadcaster NOT sending ✓\n");

    // CRITICAL: Coordinator suppression happens BEFORE broadcaster activation
    now = c.suppressionStartMs;  // T=2000 (1000 + 1000ms delay)
    printf("\nT=%u: Coordinator suppression ACTIVATES\n", now);
    assert(c.beaconsSuppressed(now));   // Coordinator suppressed now
    assert(!b.sendingBeacons());        // Broadcaster STILL not sending
    printf("  Status: Coordinator SUPPRESSED, Broadcaster NOT sending ✓\n");
    printf("  Broadcaster activates at T=%u (in %ums)\n",
           b.leaseActivationMs, b.leaseActivationMs - now);

    // Verify NO OVERLAP: gap between coordinator suppression and broadcaster activation
    const uint32_t gap = b.leaseActivationMs - c.suppressionStartMs;
    printf("  Safety margin: %ums gap (broadcaster activates %ums AFTER suppression)\n", gap, gap);
    assert(gap > 0);  // MUST have gap (no overlap)
    printf("  ✓ NO OVERLAP - Coordinator suppresses BEFORE Broadcaster activates\n");

    // Advance to just before broadcaster activation
    now = b.leaseActivationMs - 1;  // T=2549 (1050 + 1500ms - 1ms)
    printf("\nT=%u: Just before broadcaster activation (T=%u)\n", now, b.leaseActivationMs);
    assert(c.beaconsSuppressed(now));   // Coordinator still suppressed
    assert(!b.sendingBeacons());        // Broadcaster not sending yet
    printf("  Status: Coordinator SUPPRESSED, Broadcaster NOT sending ✓\n");

    // Broadcaster activates
    now = b.leaseActivationMs;  // T=2550 (1050 + 1500ms)
    printf("\nT=%u: Broadcaster activation TIME\n", now);
    broadcasterTickActivation(b, now);
    assert(c.beaconsSuppressed(now));   // Coordinator suppressed
    assert(b.sendingBeacons());         // Broadcaster NOW sending
    printf("  Status: Coordinator SUPPRESSED, Broadcaster SENDING ✓\n");
    printf("  ✓ HANDOVER SUCCESSFUL - Only broadcaster sends now\n");

    // Verify timing guarantees
    printf("\n--- Timing Analysis ---\n");
    printf("Grant sent at:            T=1000\n");
    printf("Grant received at:        T=%u (RF delay %ums)\n", 1000 + rfDelay, rfDelay);
    printf("Coordinator suppresses:   T=%u (Grant + %ums)\n",
           c.suppressionStartMs, COORDINATOR_SUPPRESSION_DELAY_MS);
    printf("Broadcaster activates:    T=%u (Grant_RX + %ums)\n",
           b.leaseActivationMs, BROADCASTER_ACTIVATION_DELAY_MS);
    printf("Safety margin:            %ums (suppression → activation)\n", gap);
    printf("Expected gap:             %ums (with RF=%ums)\n",
           BROADCASTER_ACTIVATION_DELAY_MS - COORDINATOR_SUPPRESSION_DELAY_MS + rfDelay,
           rfDelay);

    // Verify NO simultaneous sending at ANY point in time
    printf("\n--- Overlap Verification ---\n");
    bool overlapDetected = false;
    for(uint32_t t = 0; t <= now; t += 10) {
        bool coordSends = !c.beaconsSuppressed(t);
        bool bcastSends = (t >= b.leaseActivationMs) && b.sendingBeacons();
        if(coordSends && bcastSends) {
            printf("❌ OVERLAP at T=%u: Coordinator AND Broadcaster both sending!\n", t);
            overlapDetected = true;
        }
    }

    if(overlapDetected) {
        printf("FAIL: Overlap detected - concurrent senders!\n");
        return false;
    }

    printf("✓ NO OVERLAP detected in entire timeline\n");
    printf("PASS: Bootstrap timing prevents overlap (%ums gap)\n", gap);
    return true;
}

// Test 13: Probe/Reply/Final Epoch Validation
// Beta131-FIX (Eleventh cycle): Verify epoch validation uses active time source epoch
bool testProbeReplyEpochValidation() {
    printf("\n--- TEST 13: Probe/Reply/Final Epoch Validation ---\n");

    // Simulate Probe/Reply/Final epoch validation logic
    struct PendingExchange {
        bool active = false;
        uint64_t expectedTag = 0;
        uint64_t expectedBoot = 0;
        uint32_t expectedEpoch = 0;
        uint32_t nonce = 0;
    };

    struct ReplyFrame {
        uint64_t coordinatorTag = 0;
        uint64_t senderBoot = 0;
        uint32_t epoch = 0;
        uint32_t nonce = 0;
    };

    // Simulated state
    uint32_t localEpoch = 50;  // Node's local epoch
    uint64_t activeTimeSourceTag = 123;
    uint64_t activeTimeSourceBoot = 456;
    uint32_t activeTimeSourceEpoch = 100;  // Coordinator's epoch (from beacon)

    // --- Scenario 1: Bootstrap case (no beacon received yet) ---
    printf("Scenario 1: Bootstrap (expectedEpoch=0)...\n");
    {
        PendingExchange pending;
        pending.active = true;
        pending.expectedTag = 123;
        pending.expectedBoot = 0;  // Bootstrap
        pending.expectedEpoch = 0;  // Bootstrap: no beacon received yet
        pending.nonce = 42;

        ReplyFrame reply;
        reply.coordinatorTag = 123;
        reply.senderBoot = 456;
        reply.epoch = 100;  // Coordinator's epoch
        reply.nonce = 42;

        // Bootstrap-safe validation (Beta131-FIX Eleventh cycle)
        const bool bootMatches = (pending.expectedBoot == 0) ? true : (reply.senderBoot == pending.expectedBoot);
        const bool epochMatches = (pending.expectedEpoch == 0) ? true : (reply.epoch == pending.expectedEpoch);
        const bool valid = (reply.coordinatorTag == pending.expectedTag &&
                           bootMatches &&
                           epochMatches &&
                           reply.nonce == pending.nonce);

        if(!valid) {
            printf("FAIL: Bootstrap Reply rejected (should accept any epoch when expectedEpoch=0)\n");
            return false;
        }
        printf("✓ Bootstrap Reply accepted (expectedEpoch=0 accepts any epoch)\n");
    }

    // --- Scenario 2: Wrong epoch after beacon received (BUG CASE) ---
    printf("Scenario 2: Epoch mismatch (BUG: using local epoch instead of source epoch)...\n");
    {
        PendingExchange pending;
        pending.active = true;
        pending.expectedTag = activeTimeSourceTag;
        pending.expectedBoot = activeTimeSourceBoot;
        // BUG (OLD CODE): pending.expectedEpoch = localEpoch;  // WRONG!
        // This would be 50, but coordinator sends 100 → REJECTED!
        pending.expectedEpoch = localEpoch;  // Simulate OLD buggy behavior
        pending.nonce = 43;

        ReplyFrame reply;
        reply.coordinatorTag = activeTimeSourceTag;
        reply.senderBoot = activeTimeSourceBoot;
        reply.epoch = activeTimeSourceEpoch;  // 100 (coordinator's epoch)
        reply.nonce = 43;

        const bool bootMatches = (pending.expectedBoot == 0) ? true : (reply.senderBoot == pending.expectedBoot);
        const bool epochMatches = (pending.expectedEpoch == 0) ? true : (reply.epoch == pending.expectedEpoch);
        const bool valid = (reply.coordinatorTag == pending.expectedTag &&
                           bootMatches &&
                           epochMatches &&
                           reply.nonce == pending.nonce);

        if(valid) {
            printf("FAIL: Reply with wrong epoch accepted (50 != 100)\n");
            return false;
        }
        printf("✓ Reply with mismatched epoch correctly REJECTED (50 != 100)\n");
    }

    // --- Scenario 3: Correct epoch (FIXED CODE) ---
    printf("Scenario 3: Correct epoch (FIX: using active time source epoch)...\n");
    {
        PendingExchange pending;
        pending.active = true;
        pending.expectedTag = activeTimeSourceTag;
        pending.expectedBoot = activeTimeSourceBoot;
        // FIX (NEW CODE): pending.expectedEpoch = activeTimeSourceEpoch;  // CORRECT!
        pending.expectedEpoch = activeTimeSourceTag ? activeTimeSourceEpoch : 0;  // Use source epoch
        pending.nonce = 44;

        ReplyFrame reply;
        reply.coordinatorTag = activeTimeSourceTag;
        reply.senderBoot = activeTimeSourceBoot;
        reply.epoch = activeTimeSourceEpoch;  // 100 (coordinator's epoch)
        reply.nonce = 44;

        const bool bootMatches = (pending.expectedBoot == 0) ? true : (reply.senderBoot == pending.expectedBoot);
        const bool epochMatches = (pending.expectedEpoch == 0) ? true : (reply.epoch == pending.expectedEpoch);
        const bool valid = (reply.coordinatorTag == pending.expectedTag &&
                           bootMatches &&
                           epochMatches &&
                           reply.nonce == pending.nonce);

        if(!valid) {
            printf("FAIL: Reply with correct epoch rejected (100 == 100)\n");
            return false;
        }
        printf("✓ Reply with correct epoch ACCEPTED (100 == 100)\n");
    }

    // --- Scenario 4: Coordinator restart with new epoch ---
    printf("Scenario 4: Coordinator epoch change (time source switch)...\n");
    {
        uint32_t oldEpoch = 100;
        uint32_t newEpoch = 200;

        // First exchange with old epoch
        PendingExchange pending1;
        pending1.active = true;
        pending1.expectedTag = activeTimeSourceTag;
        pending1.expectedBoot = activeTimeSourceBoot;
        pending1.expectedEpoch = oldEpoch;
        pending1.nonce = 45;

        ReplyFrame reply1;
        reply1.coordinatorTag = activeTimeSourceTag;
        reply1.senderBoot = activeTimeSourceBoot;
        reply1.epoch = oldEpoch;
        reply1.nonce = 45;

        const bool valid1 = (reply1.coordinatorTag == pending1.expectedTag &&
                            (reply1.senderBoot == pending1.expectedBoot) &&
                            (reply1.epoch == pending1.expectedEpoch) &&
                            reply1.nonce == pending1.nonce);
        assert(valid1);

        // Coordinator restarts, new epoch
        activeTimeSourceEpoch = newEpoch;

        // New exchange with updated epoch
        PendingExchange pending2;
        pending2.active = true;
        pending2.expectedTag = activeTimeSourceTag;
        pending2.expectedBoot = activeTimeSourceBoot;
        pending2.expectedEpoch = activeTimeSourceEpoch;  // Updated to new epoch
        pending2.nonce = 46;

        ReplyFrame reply2;
        reply2.coordinatorTag = activeTimeSourceTag;
        reply2.senderBoot = activeTimeSourceBoot;
        reply2.epoch = newEpoch;
        reply2.nonce = 46;

        const bool valid2 = (reply2.coordinatorTag == pending2.expectedTag &&
                            (reply2.senderBoot == pending2.expectedBoot) &&
                            (reply2.epoch == pending2.expectedEpoch) &&
                            reply2.nonce == pending2.nonce);

        if(!valid2) {
            printf("FAIL: Reply with new epoch rejected after source switch\n");
            return false;
        }
        printf("✓ Epoch switch handled correctly (old=100 → new=200)\n");
    }

    printf("PASS: Epoch validation prevents exchange rejection\n");
    return true;
}

int main() {
    printf("==============================================\n");
    printf("Beta131 Lease State Machine Offline Test\n");
    printf("==============================================\n");
    printf("Parameters:\n");
    printf("  Grant Interval: %u ms\n", GRANT_INTERVAL_MS);
    printf("  Lease Duration: %u ms\n", LEASE_DURATION_MS);
    printf("  Safety Margin: %u ms\n", SAFETY_MARGIN_MS);
    printf("  Coordinator Suppression Delay: %u ms\n", COORDINATOR_SUPPRESSION_DELAY_MS);
    printf("  Broadcaster Activation Delay: %u ms\n", BROADCASTER_ACTIVATION_DELAY_MS);
    printf("  Startup Guard: %u ms\n", STARTUP_GUARD_MS);
    printf("  RF Delay: %u-%u ms\n", RF_DELAY_MIN_MS, RF_DELAY_MAX_MS);

    int passed = 0;
    int failed = 0;

    if(testNormalHandover()) ++passed; else ++failed;
    if(testRenewal()) ++passed; else ++failed;
    if(testLostGrant()) ++passed; else ++failed;
    if(testLostAck()) ++passed; else ++failed;
    if(testSourceSwitch()) ++passed; else ++failed;
    if(testDelayedRenewal()) ++passed; else ++failed;
    if(testCoordinatorReboot()) ++passed; else ++failed;
    if(testMultipleLostRenewals()) ++passed; else ++failed;
    if(testRebootDuringRenewal()) ++passed; else ++failed;
    if(testCaptureSourceSwitch()) ++passed; else ++failed;
    if(testCaptureRadioRestart()) ++passed; else ++failed;
    if(testBootstrapTiming()) ++passed; else ++failed;
    if(testProbeReplyEpochValidation()) ++passed; else ++failed;

    printf("\n==============================================\n");
    printf("Test Results: %d PASSED, %d FAILED\n", passed, failed);
    printf("==============================================\n");

    if(failed > 0) {
        printf("\n⚠️  CRITICAL: Lease state machine has FAILURES!\n");
        printf("DO NOT flash without fixing!\n");
        return 1;
    }

    printf("\n✓ All tests PASSED!\n");
    printf("\nLimitations:\n");
    printf("- RF delay fixed at 5ms (real: 1-50ms)\n");
    printf("- Clock drift not simulated\n");
    printf("- Assumes millis() monotonic\n");
    printf("- Does NOT test actual ESP-NOW send/receive\n");
    printf("\nConclusion:\n");
    printf("Sender exclusivity HOLDS under tested conditions:\n");
    printf("- RF delay ≤50ms\n");
    printf("- Clock drift negligible over 4s\n");
    printf("- Safety margin (%ums) sufficient\n", SAFETY_MARGIN_MS);
    printf("- Startup guard (%ums) prevents overlap after coordinator reboot\n", STARTUP_GUARD_MS);
    printf("- Bootstrap timing (%ums suppression, %ums activation) prevents initial overlap\n",
           COORDINATOR_SUPPRESSION_DELAY_MS, BROADCASTER_ACTIVATION_DELAY_MS);
    printf("- Bootstrap gap: %ums (coordinator suppresses BEFORE broadcaster activates)\n",
           BROADCASTER_ACTIVATION_DELAY_MS - COORDINATOR_SUPPRESSION_DELAY_MS + RF_DELAY_MAX_MS);
    printf("- Capture source generation detects coordinator↔broadcaster switches\n");
    printf("- Monotonic generation invalidates captures after radio restart\n");

    return 0;
}
