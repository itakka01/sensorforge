// Beta137/138 host test: cluster WiFi power save decisions (wifi_power_policy.h).
//   g++ -std=c++17 -Wall -Wextra -I. -x c++ test_wifi_power_policy.cpp.test -o /tmp/test_wifi_power_policy
// The service loop below mirrors WifiPowerPolicy::service() with a simulated
// esp_wifi_get_ps()/esp_wifi_set_ps(); the decisions are the real header functions.
// Beta138 rule: active cluster runtime (any role) -> WIFI_PS_NONE, otherwise the
// Arduino default (WiFi.getSleep()). Role and broadcaster lease are no inputs.

#include <stdio.h>
#include "wifi_power_policy.h"

using namespace WifiPowerPolicy;
static int g_failures = 0;
#define CHECK(cond, msg) do { if (cond) printf("  PASS %s\n", msg); \
    else { printf("  FAIL %s (line %d)\n", msg, __LINE__); ++g_failures; } } while (0)

struct FakeWifi {
    bool staUp = true;
    Mode radio = Mode::MinModem;        // what esp_wifi_get_ps() returns
    Mode arduinoSleep = Mode::MinModem; // WiFi.getSleep(): restored on STA start
    bool failSet = false;
    unsigned setCalls = 0;
    void staRestart() { radio = arduinoSleep; }  // Arduino STA_START handler
};

struct Service {
    Status st; uint32_t lastFailureMs = 0;
    void run(FakeWifi &w, bool clusterActive, uint32_t now) {
        st.clusterActive = clusterActive;
        st.expected = expectedMode(clusterActive, w.arduinoSleep);
        if (!w.staUp) { st.actual = Mode::Unknown; return; }
        st.actual = w.radio;
        if (!shouldApply(true, st.actual, st.expected, lastFailureMs, now)) return;
        ++w.setCalls;
        if (!w.failSet) { w.radio = st.expected; ++st.applies; st.actual = st.expected; lastFailureMs = 0; }
        else { ++st.applyFailures; lastFailureMs = now ? now : 1; }
    }
};

int main() {
    printf("=== WiFi power policy (beta138: active cluster -> none) ===\n");
    printf("T1 active cluster member gets WIFI_PS_NONE (coordinator, broadcaster, node alike)\n");
    { FakeWifi w; Service s; s.run(w, true, 1000);
      CHECK(w.radio == Mode::None && s.st.applies == 1, "cluster active -> none");
      CHECK(s.st.expected == Mode::None, "expected none reported"); }

    printf("T2 stable operation: no repeated set calls (lease/role are no inputs)\n");
    { FakeWifi w; Service s; for (uint32_t t = 0; t < 120000; t += 250) s.run(w, true, t);
      CHECK(w.setCalls == 1, "exactly one set call in 2 minutes"); }

    printf("T3 outside active cluster: previous behaviour unchanged\n");
    { FakeWifi w; Service s; for (uint32_t t = 0; t < 10000; t += 250) s.run(w, false, t);
      CHECK(w.radio == Mode::MinModem && w.setCalls == 0, "inactive cluster: min_modem, no set call");
      FakeWifi w2; w2.arduinoSleep = Mode::None; w2.radio = Mode::None; Service s2; s2.run(w2, false, 0);
      CHECK(w2.setCalls == 0, "Arduino sleep disabled stays disabled"); }

    printf("T4 cluster activation / deactivation and role changes\n");
    { FakeWifi w; Service s; s.run(w, false, 0);
      s.run(w, true, 250);  CHECK(w.radio == Mode::None, "cluster start -> none");
      s.run(w, true, 500);  s.run(w, true, 750);  // coordinator -> node -> broadcaster: still active
      CHECK(w.setCalls == 1, "role changes inside active cluster cause no call");
      s.run(w, false, 1000); CHECK(w.radio == Mode::MinModem, "cluster disabled -> baseline restored");
      s.run(w, true, 1250); CHECK(w.radio == Mode::None, "cluster re-enabled -> none");
      CHECK(w.setCalls == 3 && s.st.applies == 3, "one call per activation change"); }

    printf("T5 reconnect / STA re-init restores the required setting\n");
    { FakeWifi w; Service s; s.run(w, true, 0);
      w.staUp = false; s.run(w, true, 250);
      CHECK(s.st.actual == Mode::Unknown && w.setCalls == 1, "STA down: no call, actual unknown");
      w.staUp = true; w.staRestart(); s.run(w, true, 500);
      CHECK(w.radio == Mode::None && w.setCalls == 2, "after STA restart none re-applied");
      w.staRestart(); s.run(w, false, 750);
      CHECK(w.setCalls == 2, "restart while cluster inactive: baseline kept, no call"); }

    printf("T6 API failures are visible and backed off\n");
    { FakeWifi w; w.failSet = true; Service s;
      for (uint32_t t = 1000; t < 6000; t += 250) s.run(w, true, t);
      CHECK(s.st.applyFailures == 1, "one failure within 5 s back-off");
      s.run(w, true, 6000);
      CHECK(s.st.applyFailures == 2, "retry after back-off, failure counted");
      w.failSet = false; s.run(w, true, 11000);
      CHECK(w.radio == Mode::None && s.st.applies == 1, "recovers when the API succeeds");
      CHECK(!shouldApply(true, Mode::Unknown, Mode::None, 0, 0), "unknown actual mode never triggers a set");
      CHECK(!shouldApply(true, Mode::None, Mode::Unknown, 0, 0), "unknown expected mode never triggers a set"); }

    printf("=== %s (%d failures) ===\n", g_failures ? "FAILED" : "ALL PASSED", g_failures);
    return g_failures ? 1 : 0;
}
